---
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import type { GallerySlide } from '@/lib/gallery';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const visibleProjects = await getCollection('projects', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  // Filter out placeholder entries and solo-page projects.
  // Solo-page projects have their own dedicated .astro file (e.g.
  // sparkforge.astro) — Astro's file-based router gives static routes
  // priority over [slug], so we exclude them here to avoid collisions.
  const routableProjects = visibleProjects.filter(
    (p) => !p.data.placeholder && !p.data.soloPage,
  );

  return routableProjects.map((project) => ({
    params: { slug: project.id.replace(/\.mdx?$/, '') },
    props: {
      project,
      related: visibleProjects
        .filter((p) => p.id !== project.id)
        .sort((a, b) => a.data.order - b.data.order)
        .slice(0, 3),
    },
  }));
}

const { project, related } = Astro.props;
const { Content, headings } = await render(project);
---

<ProjectLayout
  title={project.data.title}
  description={project.data.description}
  meta={project.data.meta}
  url={project.data.url}
  repo={project.data.repo}
  image={project.data.image}
  imageAlt={project.data.imageAlt}
  gallery={project.data.gallery as GallerySlide[]}
  tags={project.data.tags}
  slug={project.id.replace(/\.mdx?$/, '')}
  related={related}
  headings={headings}
  toc={project.data.toc}
  logo={project.data.logo}
>
  <Content />
</ProjectLayout>
