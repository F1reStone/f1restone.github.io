---
/**
 * Projects page
 * URL: /projects
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { Hero } from '@/components/hero';
import { getCollection } from 'astro:content';

const items = await getCollection('projects', ({ data }) => !data.draft);
const projects = items.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="项目"
  description="一些由 FireStone 火石制作的有趣（？）作品。"
  eagerReveal
>
  <Hero layout="split" size="xl" class="hero-dark-gradient invert-section" showScrollIndicator>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      项目
    </Badge>

    <h1 slot="title" class="hero-title-wrapper !text-[clamp(2.5rem,12vw,4rem)] sm:!text-6xl md:!text-7xl lg:!text-8xl tracking-tight z-10 relative">
      <span class="hero-title-text">Projects</span>
    </h1>

    <p slot="description" class="hero-description-text">一些由我制作的有趣（？）作品。</p>
  </Hero>

  <!-- All projects -->
  {projects.length > 0 && (
    <section class="py-[var(--space-section-md)] bg-background">
      <div class="mx-auto max-w-8xl px-6 flex flex-col gap-8">

        <div class="grid gap-6 md:grid-cols-2">
          {projects.map((project, i) => (
            <ProjectCard project={project} index={i} />
          ))}
        </div>
      </div>
    </section>
  )}

</PageLayout>
