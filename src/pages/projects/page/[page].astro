---
import ProjectsPageView from '@/components/projects/views/ProjectsPageView.astro';
import { defaultLocale } from '@/i18n';
import {
  getVisibleProjects,
  PROJECTS_PER_PAGE,
} from '@/lib/projects';

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  const totalPages = Math.max(1, Math.ceil(projects.length / PROJECTS_PER_PAGE));

  // Page 1 lives at /projects; only emit /projects/page/2..N from this route.
  const pages: { params: { page: string }; props: { page: number; totalPages: number } }[] = [];
  for (let page = 2; page <= totalPages; page++) {
    pages.push({ params: { page: String(page) }, props: { page, totalPages } });
  }
  return pages;
}
---

<ProjectsPageView locale={defaultLocale} {...Astro.props} />
