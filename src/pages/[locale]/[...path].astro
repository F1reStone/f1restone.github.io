---
import { getFallbackPages } from '@/lib/page-routes';
import { getCollection } from 'astro:content';
import { getPostUrl } from '@/lib/blog';
import { getPostTranslations } from '@/lib/post-links';
import { defaultLocale } from '@/i18n';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ data }) => data.locale === defaultLocale && (!import.meta.env.PROD || !data.draft)
  );
  const postByPath = new Map(
    posts.map((post) => [encodeURI(getPostUrl(post.id, defaultLocale)), post])
  );
  return Promise.all(
    (await getFallbackPages()).map(async ({ locale, sourcePath }) => {
      const post = postByPath.get(sourcePath);
      const translation =
        post &&
        (await getPostTranslations(post.id, defaultLocale, post.data.uid)).find(
          (item) => item.locale === locale
        );
      const destination = translation?.url ?? sourcePath;
      return {
        params: { locale, path: decodeURI(sourcePath.slice(1)) || undefined },
        props: { sourcePath: destination.endsWith('/') ? destination : `${destination}/` },
      };
    })
  );
}

return Astro.rewrite(Astro.props.sourcePath);
---
