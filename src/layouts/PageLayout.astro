---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
  /**
   * Footer background. Set this to the opposite of the page's last section so
   * the zebra pattern (bg-background ↔ bg-background-secondary) stays intact.
   */
  footerBackground?: 'default' | 'secondary' | 'invert';
  /** Raw SVG string for a secondary logo in the Header (Chameleon pattern). */
  secondaryLogoSvg?: string;
  /** Optional link for the secondary logo. */
  secondaryLogoHref?: string;
}

const { title, description, image, imageAlt, noindex, nofollow, showScrollProgress = false, eagerReveal = false, footerBackground: _footerBackground = 'default', secondaryLogoSvg, secondaryLogoHref } = Astro.props;

---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  eagerReveal={eagerReveal}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    showActiveState
    showCta={false}
    showScrollProgress={showScrollProgress}
    secondaryLogoSvg={secondaryLogoSvg}
    secondaryLogoHref={secondaryLogoHref}
  />

  <main class="min-h-screen">
    <slot />
  </main>

  <Footer
    slot="footer"
  />
</BaseLayout>
