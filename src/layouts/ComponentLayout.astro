---
import { buildBreadcrumbs, type BreadcrumbItem } from '@/lib/breadcrumbs';
import { getLocaleFromPath } from '@/i18n';
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  breadcrumbs?: BreadcrumbItem[] | false;
  breadcrumbLabel?: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
  footerBackground?: 'default' | 'secondary' | 'invert';
}

const { title, description, image, imageAlt, noindex, nofollow, showScrollProgress = false, eagerReveal = false } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const breadcrumbs = Astro.props.breadcrumbs === false ? [] : Astro.props.breadcrumbs ?? buildBreadcrumbs(Astro.props.breadcrumbLabel ?? title, Astro.url.pathname, locale);
---

<BaseLayout
  breadcrumbs={breadcrumbs}
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  eagerReveal={eagerReveal}
>
  <Header
    slot="header"
    position="sticky"
    shape="bar"
    colorScheme='default'
    showActiveState
    showCta={false}
    showScrollProgress={showScrollProgress}
  />

  <main class="min-h-screen">
    <slot />
  </main>

  <Footer breadcrumbs={breadcrumbs}
    slot="footer"
  />
</BaseLayout>
