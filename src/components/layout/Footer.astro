---
/**
 * Footer Component
 * Flexible footer with variant-based configuration
 *
 * Layouts:
 * - simple: Single row with logo, nav links, and social
 * - columns: Multi-column layout with link groups
 * - minimal: Just copyright
 * - stacked: Vertically stacked logo, nav, copyright
 *
 * Features:
 * - Dynamic navigation from nav.config.ts (default) or custom nav prop
 * - Social links with icon support
 * - Copyright with {year} placeholder
 * - Legal links section
 * - Full slot support for customization
 */
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/cn';
import {
  getNavItems,
  getFooterNavItems,
  getLegalLinks,
  getFooterLinkGroups, // FireStone: Import the new global getter
  type NavItem as NavConfigItem,
  type ResolvedNavItem,
} from '@/config/nav.config';
import { footerVariants, footerColumnGridVariants } from './footer.variants';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import Logo from '@/components/ui/marketing/Logo/Logo.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import siteConfig from '@/config/site.config';
import { resolveSocialLinks, type ResolvedSocialLink } from '@/lib/utils'; // FireStone: Import the central resolver

export interface NavItem {
  label: string;
  href: string;
  external?: boolean;
}

export interface FooterLinkGroup {
  title: string;
  links: NavItem[];
}

/**export interface SocialLink {
  platform: 'github' | 'bilibili' | 'youtube' | 'x-twitter' | string;
  href: string;
  label?: string;
}*/

export interface LegalLink {
  label: string;
  href?: string;
  icon?: string;
  action?: 'openConsentSettings';
}

interface Props extends HTMLAttributes<'footer'> {
  /** Layout style */
  layout?: 'simple' | 'columns' | 'minimal' | 'stacked';
  /** Number of columns (only for columns layout) */
  columns?: 2 | 3 | 4 | 5 | 6;
  /** Background variant */
  background?: 'default' | 'secondary' | 'invert';
  /** Override default navigation */
  nav?: NavItem[];
  /** Link groups for columns layout */
  linkGroups?: FooterLinkGroup[];
  /** Social media links */
  socialLinks?: ResolvedSocialLink[]; // FireStone: [Use the shared interface]
  /** Show social links */
  showSocial?: boolean;
  /** Show copyright */
  showCopyright?: boolean;
  /** Custom copyright text (supports {year} and {siteName} placeholders) */
  copyright?: string;
  /** Legal links (Privacy, Terms, etc.) */
  legalLinks?: LegalLink[];
  /** Hide logo */
  hideLogo?: boolean;
  /** Tagline text under logo */
  tagline?: string;
  // FireStone: [Add '8xl' and '9xl' to the props interface]
  maxWidth?: '4xl' | '5xl' | '6xl' | '7xl' | '8xl' | '9xl' | 'full';
  // FireStone: Added explicit props for the Smart Breadcrumb Engine
  /** 如果传入，将覆盖自动生成的面包屑 */
  breadcrumbs?: { label: string; href?: string }[];
  /** 强制隐藏面包屑（如首页默认隐藏） */
  hideBreadcrumbs?: boolean;
}

const {
  layout = 'columns',
  columns = 5,
  background = 'default',
  nav,
  linkGroups = getFooterLinkGroups(),// FireStone: Fallback to global link groups instead of an empty array
  socialLinks = resolveSocialLinks(siteConfig.socialLinks),
  showSocial = true,
  showCopyright = true,
  copyright = 'Copyright © {year} FireStone. All Rights Reserved.',
  legalLinks,
  hideLogo = false,
  tagline = '兴趣使然的业余开发者 / 设计师 / 内容创作者「FireStone 火石」的个人网站。在这里分享一些我的有趣作品和技术心得。',
  maxWidth = '8xl',// FireStone: Change max width to 8xl to adapt out designs.
  breadcrumbs: explicitBreadcrumbs, // 接收手动传入的面包屑
  hideBreadcrumbs = false,          // 接收强制隐藏指令
  class: className,
  ...attrs
} = Astro.props;

const maxWidthClass = {
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
  '7xl': 'max-w-7xl',
  '8xl': 'max-w-8xl',
  '9xl': 'max-w-9xl',
  full: 'max-w-full',
}[maxWidth];

// Get navigation items — footer nav is configured independently from the
// header in `nav.config.ts` (see `footerNavItems`).
const defaultNav: NavItem[] = getFooterNavItems().map((item: ResolvedNavItem) => ({
  label: item.label,
  href: item.href,
  external: item.external,
}));
const navItems: NavItem[] = nav || defaultNav;
const allNavItems: NavItem[] = navItems;

// Resolved legal links: prop wins, otherwise fall back to nav.config.ts
const resolvedLegalLinks: LegalLink[] = legalLinks ?? getLegalLinks();

// Process copyright text
const currentYear = new Date().getFullYear();
const processedCopyright = copyright
  .replace('{year}', String(currentYear))
  .replace('{siteName}', siteConfig.name);

// FireStone: Added class names for legal links and separators for better styling control
const legalLinkClass =
  'inline-flex items-center gap-2 text-sm transition-colors text-foreground-muted hover:text-foreground';

const legalSeparatorClass = 'mx-3 h-4 w-px bg-border';

// Check slots
const hasLogoSlot = Astro.slots.has('logo');
const hasTaglineSlot = Astro.slots.has('tagline');
const hasColumnsSlot = Astro.slots.has('columns');
const hasSocialSlot = Astro.slots.has('social');
const hasBottomSlot = Astro.slots.has('bottom');

// =========================================================================
// Auto-Routing Breadcrumb
// =========================================================================
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '/en-US' || currentPath === '/en-US/';

let resolvedBreadcrumbs = explicitBreadcrumbs;

// 如果没有手动传入，且不是首页，且没有被强制隐藏，则开启自动生成
if (!resolvedBreadcrumbs && !hideBreadcrumbs && !isHomePage) {
  // 1. 构建全局路由字典 (合并头部导航和底部导航)
  const dict: Record<string, string> = { '/': '首页', '/en-US': 'Home', '/en-US/': 'Home' };
  const allNavs = [...getNavItems(), ...getFooterLinkGroups().flatMap(g => g.links)];
  allNavs.forEach(item => {
    const normalized = item.href.replace(/\/$/, ''); // 去除末尾斜杠以统配
    dict[normalized] = item.label;
  });

  // 2. 切分当前路径
  const segments = currentPath.replace(/\/$/, '').split('/').filter(Boolean);
  
  // 3. 处理多语言前缀基准
  let basePath = '';
  let startIndex = 0;
  if (segments[0] === 'en-US') {
    basePath = '/en-US';
    startIndex = 1;
    resolvedBreadcrumbs = [{ label: 'Home', href: '/en-US' }];
  } else {
    resolvedBreadcrumbs = [{ label: '首页', href: '/' }];
  }

  // 4. 逐级生成层级
  let pathAcc = basePath;
  for (let i = startIndex; i < segments.length; i++) {
    const seg = segments[i];
    pathAcc += '/' + seg;
    
    // 查字典，如果字典里没有（比如动态页面的最后一级），则首字母大写作为 fallback
    let label = dict[pathAcc];
    if (!label) {
      label = seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' ');
    }
    
    resolvedBreadcrumbs.push({
      label,
      href: i === segments.length - 1 ? undefined : pathAcc // 最后一级没有链接
    });
  }
}

// 最终判定是否渲染：有数据且至少有两级（排除只有"首页"的情况）
const showBreadcrumbs = resolvedBreadcrumbs && resolvedBreadcrumbs.length > 1 && !hideBreadcrumbs;

// Compute footer classes
const footerClasses = cn(footerVariants({ background }), className);

// Social platform to icon mapping
/**const socialIcons: Record<string, string> = {
  'github': 'github',
  'bilibili': 'bilibili',
  'youtube': 'youtube',
  'x-twitter': 'x-twitter',
};*/

// Get icon for social platform
/**function getSocialIcon(platform: string): string {
  return socialIcons[platform] || platform;
}*/
---

<footer class={footerClasses} data-pagefind-ignore {...attrs}>
  <div class={cn('mx-auto px-6', maxWidthClass)}>

    {showBreadcrumbs && (
      <div class="pb-6 mb-6 md:mb-8 border-b border-border/50">
        <Breadcrumbs items={resolvedBreadcrumbs || []} />
      </div>
    )}

    {layout === 'simple' && (
      <>
      <div class="flex flex-col md:flex-row justify-between items-center gap-[var(--space-stack-lg)]">
        {/* Logo & Tagline */}
        {!hideLogo && (
          <div class="flex flex-col items-center md:items-start gap-2">
            {hasLogoSlot ? (
              <slot name="logo" />
            ) : (
              <a href="/" class="flex items-center w-fit justify-self-start" aria-label="FireStone Logo">
                <Logo size="md" class="text-foreground" />
              </a>
            )}
            {(hasTaglineSlot || tagline) && (
              <p class="text-sm text-foreground-muted">
                {hasTaglineSlot ? <slot name="tagline" /> : tagline}
              </p>
            )}
          </div>
        )}

        {/* Navigation Links */}
        <nav class="flex flex-wrap justify-center gap-[var(--space-inline-lg)] md:gap-[var(--space-stack-lg)] text-sm font-medium text-foreground-muted">
          {allNavItems.map((item) => (
            <a
              href={item.href}
              class="transition-colors hover:text-foreground"
              target={item.external || item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.external || item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        {/* Social Links */}
        {showSocial && socialLinks.length > 0 && (
          hasSocialSlot ? (
            <slot name="social" />
          ) : (
            <div class="flex items-center gap-[var(--space-stack-md)]">
              {socialLinks.map((social) => (
                <a
                  href={social.href}
                  class="transition-colors text-foreground-muted hover:text-foreground"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label || `在 ${social.key} 上关注我`}
                >
                  <Icon name={social.icon} size="md" />
                </a>
              ))}
            </div>
          )
        )}
      </div>
      {showCopyright && (
        <div class="mt-[var(--space-stack-lg)] pt-[var(--space-stack-lg)] border-t border-border text-center">
          <p class="text-sm text-foreground-muted" set:html={processedCopyright} />
        </div>
      )}
      </>
    )}

    {layout === 'columns' && (
      <>
        <div class={footerColumnGridVariants({ columns })}>
          {/* Logo Column */}
          {!hideLogo && (
            <div class="space-y-[var(--space-stack-md)]">
              {hasLogoSlot ? (
                <slot name="logo" />
              ) : (
                <a href="/" class="flex items-center w-fit justify-self-start" aria-label="FireStone Logo">
                  <Logo size="md" class="text-foreground" />
                </a>
              )}
              {(hasTaglineSlot || tagline) && (
                <p class="text-sm max-w-xs text-foreground-muted">
                  {hasTaglineSlot ? <slot name="tagline" /> : tagline}
                </p>
              )}
              {/* Social Links in columns layout */}
              {showSocial && socialLinks.length > 0 && (
                <div class="flex flex-col gap-2.5 pt-2">
                  <p class="footer-social-link-intro">社交媒体</p>
                  <div class="flex items-center gap-[var(--space-stack-md)]">
                    {socialLinks.map((social) => (
                      <a
                        href={social.href}
                        class="transition-colors text-foreground-muted hover:text-foreground"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={social.label || `Follow us on ${social.key}`}
                      >
                        <Icon name={social.icon} size="md" />
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          {/* Link Groups */}
          {hasColumnsSlot ? (
            <slot name="columns" />
          ) : (
            linkGroups.map((group) => (
              <div class="space-y-[var(--space-stack-md)]">
                <h3 class="font-semibold text-sm text-foreground">
                  {group.title}
                </h3>
                <ul class="space-y-2">
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-sm transition-colors text-foreground-muted hover:text-foreground"
                        target={link.external || link.href.startsWith('http') ? '_blank' : undefined}
                        rel={link.external || link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          )}
        </div>

        {/* Bottom section */}
        {(showCopyright || resolvedLegalLinks.length > 0) && (
          <div class="mt-[var(--space-section-header)] pt-[var(--space-stack-lg)] border-t border-border flex flex-col md:flex-row justify-between items-left gap-[var(--space-stack-md)]">
            {hasBottomSlot ? (
              <slot name="bottom" />
            ) : (
              <>
                {showCopyright && (
                  <p class="text-sm text-foreground-muted" set:html={processedCopyright} />
                )}
                {resolvedLegalLinks.length > 0 && (
                  <div class="flex flex-wrap items-center">
                    {resolvedLegalLinks.map((link, index) => (
                      <div class="contents">
                        {index > 0 && (
                          <span aria-hidden="true" class={legalSeparatorClass} />
                        )}

                        {link.action === 'openConsentSettings' ? (
                          <button
                            type="button"
                            class={legalLinkClass}
                            data-consent-settings-trigger
                          >
                            {link.icon && (
                              <Icon name={link.icon} size="sm" />
                            )}
                            <span>{link.label}</span>
                          </button>
                        ) : (
                          <a
                            href={link.href}
                            class={legalLinkClass}
                            target={link.href?.startsWith('http') ? '_blank' : undefined}
                            rel={link.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                          >
                            {link.icon && (
                              <Icon name={link.icon} size="sm" />
                            )}
                            <span>{link.label}</span>
                          </a>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </>
            )}
          </div>
        )}
      </>
    )}

    {layout === 'minimal' && (
      <div class="text-center">
        {showCopyright && (
          <p class="text-sm text-foreground-muted" set:html={processedCopyright} />
        )}
      </div>
    )}

    {layout === 'stacked' && (
      <div class="flex flex-col items-center gap-[var(--space-stack-lg)] text-center">
        {/* Logo */}
        {!hideLogo && (
          hasLogoSlot ? (
            <slot name="logo" />
          ) : (
            <a href="/" class="flex items-center w-fit justify-self-start" aria-label="FireStone Logo">
              <Logo size="md" class="text-foreground" />
            </a>
          )
        )}

        {/* Tagline */}
        {(hasTaglineSlot || tagline) && (
          <p class="text-sm max-w-md text-foreground-muted">
            {hasTaglineSlot ? <slot name="tagline" /> : tagline}
          </p>
        )}

        {/* Navigation Links */}
        <nav class="flex flex-wrap justify-center gap-[var(--space-inline-lg)] text-sm font-medium text-foreground-muted">
          {allNavItems.map((item) => (
            <a
              href={item.href}
              class="transition-colors hover:text-foreground"
              target={item.external || item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.external || item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        {/* Social Links */}
        {showSocial && socialLinks.length > 0 && (
          <div class="flex items-center gap-[var(--space-stack-md)]">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                class="transition-colors text-foreground-muted hover:text-foreground"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label || `Follow us on ${social.key}`}
              >
                <Icon name={social.icon} size="md" />
              </a>
            ))}
          </div>
        )}

        {/* Copyright & Legal */}
        {(showCopyright || resolvedLegalLinks.length > 0) && (
          <div class="pt-[var(--space-stack-lg)] border-t border-border w-full flex flex-col items-center gap-[var(--space-stack-md)]">
            {showCopyright && (
              <p class="text-sm text-foreground-muted" set:html={processedCopyright} />
            )}
            {resolvedLegalLinks.length > 0 && (
              <div class="flex items-center gap-[var(--space-inline-lg)]">
                {resolvedLegalLinks.map((link) => (
                  <a
                    href={link.href}
                    class="text-sm transition-colors text-foreground-muted hover:text-foreground"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    )}
  </div>

  {/* Default slot for additional content */}
  <slot />
  <script is:inline>
    if (!window.__footerConsentSettingsBound) {
      window.__footerConsentSettingsBound = true;

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element
          ? event.target.closest('[data-consent-settings-trigger]')
          : null;

        if (!target) return;

        event.preventDefault();
        window.openConsentSettings?.();
      });
    }
  </script>
  
  <style is:global>
    /* FireStone: Social links follow text*/
    .footer-social-link-intro {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-foreground-subtle);
    }

  </style>

</footer>
