---
/**
 * Footer Component
 * Flexible footer with variant-based configuration
 *
 * Layouts:
 * - simple: Single row with logo, nav links, and social
 * - columns: Multi-column layout with link groups
 * - minimal: Just copyright
 * - stacked: Vertically stacked logo, nav, copyright
 *
 * Features:
 * - Dynamic navigation from nav.config.ts (default) or custom nav prop
 * - Social links with icon support
 * - Copyright with {year} placeholder
 * - Legal links section
 * - Full slot support for customization
 */
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/cn';
import {
  getFooterNavItems,
  getLegalLinks,
  getFooterLinkGroups, // FireStone: Import the new global getter
  type ResolvedNavItem,
  type LegalLink as ConfigLegalLink,
} from '@/config/nav.config';
import { footerVariants, footerColumnGridVariants } from './footer.variants';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from '@/components/ui/marketing/Logo/Logo.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import siteConfig from '@/config/site.config';
import { resolveSocialLinks, type ResolvedSocialLink } from '@/lib/utils'; // FireStone: Import the central resolver
import giantLogoRaw from '@/assets/firestone-text-gradient.svg?raw'; // FireStone: Import the giant logo SVG as raw string
import { getLocaleFromPath, t, localizedPath } from '@/i18n';
import { getDerivedFooterGroups } from '@/lib/footer';
import NewsletterForm from '@/components/patterns/NewsletterForm.astro';

export interface NavItem {
  label: string;
  href: string;
  external?: boolean;
}

export interface FooterLinkGroup {
  title: string;
  links: NavItem[];
}

/**export interface SocialLink {
  platform: 'github' | 'bilibili' | 'youtube' | 'x-twitter' | string;
  href: string;
  label?: string;
}*/

export type LegalLink = ConfigLegalLink;

interface Props extends HTMLAttributes<'footer'> {
  /** Layout style */
  layout?: 'simple' | 'columns' | 'asymmetricColumns' | 'minimal' | 'stacked';
  /** Number of columns (only for columns layout) */
  columns?: 2 | 3 | 4 | 5 | 6;
  /** Background variant */
  background?: 'default' | 'secondary' | 'invert' | 'glow'; // FireStone: Added glow background variant
  /** Override default navigation */
  nav?: NavItem[];
  /** Link groups for columns layout */
  linkGroups?: FooterLinkGroup[];
  /** Social media links */
  socialLinks?: ResolvedSocialLink[]; // FireStone: [Use the shared interface]
  /** Show social links */
  showSocial?: boolean;
  /** Show copyright */
  showCopyright?: boolean;
  /** Custom copyright text (supports {year} and {siteName} placeholders) */
  copyright?: string;
  /** Legal links (Privacy, Terms, etc.) */
  legalLinks?: LegalLink[];
  /** Verified same-content links, including translations with different slugs. */
  languageAlternates?: Record<string, string>;
  /** Hide logo */
  hideLogo?: boolean;
  /** Tagline text under logo */
  tagline?: string;
  // FireStone: [Add '8xl' and '9xl' to the props interface]
  maxWidth?: '4xl' | '5xl' | '6xl' | '7xl' | '8xl' | '9xl' | 'full';
  // FireStone: Added explicit props for the Smart Breadcrumb Engine
  /** Page-owned breadcrumb hierarchy. No automatic URL inference. */
  breadcrumbs?: { label: string; href?: string }[];
  /** 强制隐藏面包屑（如首页默认隐藏） */
  hideBreadcrumbs?: boolean;
  // FireStone: Added support for footer giant logo
  giantLogoSvg?: string;
}

// Resolve the current locale for i18n-aware nav/legal/group links
const locale = getLocaleFromPath(Astro.originPathname);
const configuredGroups = getFooterLinkGroups(locale);
// Explicit props (including an empty list) override both configured and derived groups.
const defaultGroups = Astro.props.linkGroups ?? (configuredGroups.length ? configuredGroups : await getDerivedFooterGroups(locale));

const {
  layout = 'asymmetricColumns',
  columns = 5,
  background = 'glow',
  nav,
  linkGroups = defaultGroups,
  socialLinks = resolveSocialLinks(siteConfig.socialLinks, locale),
  showSocial = true,
  showCopyright = true,
  copyright = t('footer.copyright', locale),
  legalLinks,
  languageAlternates,
  hideLogo = false,
  tagline = '',
  maxWidth = '9xl',// FireStone: Change max width to 9xl to adapt out designs and wider footer.
  breadcrumbs: explicitBreadcrumbs, // 接收手动传入的面包屑
  hideBreadcrumbs = false,          // 接收强制隐藏指令
  giantLogoSvg: _giantLogoSvg,
  class: className,
  ...attrs
} = Astro.props;

const maxWidthClass = {
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
  '7xl': 'max-w-7xl',
  '8xl': 'max-w-8xl',
  '9xl': 'max-w-9xl',
  full: 'max-w-full',
}[maxWidth];

// Get navigation items — footer nav is configured independently from the
// header in `nav.config.ts` (see `footerNavItems`).
const defaultNav: NavItem[] = getFooterNavItems(locale).map((item: ResolvedNavItem) => ({
  label: item.label,
  href: item.href,
  external: item.external,
}));
const navItems: NavItem[] = nav || defaultNav;
const allNavItems: NavItem[] = navItems;

// Resolved legal links: prop wins, otherwise fall back to nav.config.ts
const resolvedLegalLinks: LegalLink[] = legalLinks ?? getLegalLinks(locale);

// Process copyright text
const currentYear = new Date().getFullYear();
const processedCopyright = copyright
  .replace('{year}', String(currentYear))
  .replace('{siteName}', siteConfig.name);

// FireStone: Added class names for legal links and separators for better styling control
const legalLinkClass =
  'inline-flex items-center gap-1 text-sm font-medium transition-colors text-foreground/60 hover-glow-text hover-glow-icon hover:text-foreground focus-visible:text-foreground';

const legalSeparatorClass = 'mx-3 h-4 w-[1.5px] bg-foreground-subtle/30';

// External arrows share the separator tone; SVG strokes use color, not background-color.
const externalArrowClass = 'text-foreground-muted/60 hover:text-foreground focus-visible:text-foreground';

// Check slots
const hasLogoSlot = Astro.slots.has('logo');
const hasTaglineSlot = Astro.slots.has('tagline');
const hasColumnsSlot = Astro.slots.has('columns');
const hasSocialSlot = Astro.slots.has('social');
const hasBottomSlot = Astro.slots.has('bottom');

// FireStone: 处理巨型 Logo，加入 typeof 安全锁防止误传对象导致全站崩溃
// 如果确实是字符串，就剥离硬编码宽高，并注入全宽和主题色继承类名
const safeGiantLogoStr = typeof giantLogoRaw === 'string' ? giantLogoRaw : '';
const cleanGiantLogoSvg = safeGiantLogoStr
  ? safeGiantLogoStr
      .replace(/\s(width|height)="[^"]*"/g, '')
      .replace(/^<svg/, '<svg class="w-full h-auto text-foreground" fill="currentColor"')
  : null;

// Page layouts own the hierarchy; Footer only renders it.
const resolvedBreadcrumbs = explicitBreadcrumbs;
const showBreadcrumbs = resolvedBreadcrumbs && resolvedBreadcrumbs.length > 1 && !hideBreadcrumbs;

// Compute footer classes
const footerClasses = cn(footerVariants({ background }), className);

// Social platform to icon mapping
/**const socialIcons: Record<string, string> = {
  'github': 'github',
  'bilibili': 'bilibili',
  'youtube': 'youtube',
  'x-twitter': 'x-twitter',
};*/

// Get icon for social platform
/**function getSocialIcon(platform: string): string {
  return socialIcons[platform] || platform;
}*/
---

<footer class={cn(footerClasses, "relative overflow-hidden")} data-pagefind-ignore {...attrs}>
  {background === 'glow' && (
    <div
      class="footer-aurora-high-layer absolute inset-0 z-0 overflow-hidden pointer-events-none"
      aria-hidden="true"
    >
      <div class="footer-mask-layer absolute inset-0 h-full w-full">
        <div class="aurora-blob aurora-cyan"></div>
        <div class="aurora-blob aurora-pink"></div>
        <div class="aurora-blob aurora-purple"></div>
      </div>
    </div>
  )}
  <div class={cn('mx-auto px-6 relative z-10', maxWidthClass)}>

    {showBreadcrumbs && (
      <div class="mb-6">
        <Breadcrumbs items={resolvedBreadcrumbs || []} />
      </div>
    )}

    <div class="pt-8 border-t border-foreground-subtle/25"></div>

    {layout === 'simple' && (
      <>
      <div class="flex flex-col md:flex-row justify-between items-center gap-[var(--space-stack-lg)]">
        {/* Logo & Tagline */}
        {!hideLogo && (
          <div class="flex flex-col items-center md:items-start gap-2">
            {hasLogoSlot ? (
              <slot name="logo" />
            ) : (
              <a href={localizedPath('/', locale)} class="flex items-center w-fit justify-self-start" aria-label={t('common.logo', locale)}>
                <Logo size="md" class="text-foreground hdr-logo-glow" />
              </a>
            )}
            {(hasTaglineSlot || tagline) && (
              <p class="text-sm text-foreground-muted">
                {hasTaglineSlot ? <slot name="tagline" /> : tagline}
              </p>
            )}
          </div>
        )}

        {/* Navigation Links */}
        <nav class="flex flex-wrap justify-center gap-[var(--space-inline-lg)] md:gap-[var(--space-stack-lg)] text-sm font-medium text-foreground-muted">
          {allNavItems.map((item) => (
            <a
              href={item.href}
              class="inline-flex items-center gap-2 transition-colors hover-glow-icon hover:text-foreground focus-visible:text-foreground"
              target={item.external || item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.external || item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {item.label}
              {item.external && <Icon name="arrow-up-right" size="sm" class={externalArrowClass} aria-hidden="true" />}
            </a>
          ))}
        </nav>

        {/* Social Links */}
        {showSocial && socialLinks.length > 0 && (
          hasSocialSlot ? (
            <slot name="social" />
          ) : (
            <div class="flex items-center gap-[var(--space-stack-md)]">
              {socialLinks.map((social) => (
                <a
                  href={social.href}
                  class="transition-colors text-foreground-muted hover-glow-icon hover:text-foreground focus-visible:text-foreground"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label || t('footer.followOn', locale, { platform: social.key })}
                >
                  <Icon name={social.icon} size="md" />
                </a>
              ))}
            </div>
          )
        )}
      </div>
      {showCopyright && (
        <div class="mt-[var(--space-stack-lg)] pt-[var(--space-stack-lg)] border-t border-border text-center">
          <p class="text-sm text-foreground-muted" set:html={processedCopyright} />
        </div>
      )}
      </>
    )}

    {layout === 'columns' && (
      <>
        <div class={footerColumnGridVariants({ columns })}>
          {/* Logo Column */}
          {!hideLogo && (
            <div class="space-y-[var(--space-stack-md)]">
              {hasLogoSlot ? (
                <slot name="logo" />
              ) : (
                <a href={localizedPath('/', locale)} class="flex items-center w-fit justify-self-start" aria-label={t('common.logo', locale)}>
                  <Logo size="md" class="text-foreground hdr-logo-glow" />
                </a>
              )}
              {(hasTaglineSlot || tagline) && (
                <p class="text-sm max-w-xs text-foreground-muted">
                  {hasTaglineSlot ? <slot name="tagline" /> : tagline}
                </p>
              )}
              {/* Social Links in columns layout */}
              {showSocial && socialLinks.length > 0 && (
                <div class="flex flex-col gap-2.5 pt-2">
                  <p class="footer-social-link-intro">{t('footer.socialMedia', locale)}</p>
                  <div class="flex items-center gap-[var(--space-stack-md)]">
                    {socialLinks.map((social) => (
                      <a
                        href={social.href}
                        class="transition-colors text-foreground-muted hover-glow-icon hover:text-foreground focus-visible:text-foreground"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={social.label || t('footer.followOn', locale, { platform: social.key })}
                      >
                        <Icon name={social.icon} size="md" />
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          {/* Link Groups */}
          {hasColumnsSlot ? (
            <slot name="columns" />
          ) : (
            linkGroups.map((group) => (
              <div class="space-y-[var(--space-stack-md)]">
                <div class="font-medium font-mono uppercase tracking-[0.15em] text-xs text-foreground">
                  {group.title}
                </div>
                <ul class="space-y-2">
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="footer-group-link text-sm transition-colors text-foreground-muted weight-shift hover-glow-text hover-glow-icon hover:text-foreground focus-visible:text-foreground"
                        data-text={link.label}
                        target={link.external || link.href.startsWith('http') ? '_blank' : undefined}
                        rel={link.external || link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      >
                        <span>{link.label}</span>
                        {link.external && <Icon name="arrow-up-right" size="sm" class={externalArrowClass} aria-hidden="true" />}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          )}
        </div>

        {/* Bottom section */}
        {(showCopyright || resolvedLegalLinks.length > 0) && (
          <div class="mt-[var(--space-stack-lg)] pt-[var(--space-stack-lg)] border-t border-border flex flex-col lg:flex-row lg:flex-wrap justify-between items-start lg:items-center gap-[var(--space-stack-md)]">
            {hasBottomSlot ? (
              <slot name="bottom" />
            ) : (
              <>
                {showCopyright && (
                  <p class="text-sm font-semibold text-foreground-subtle" set:html={processedCopyright} />
                )}
                <div class="flex flex-col items-start gap-4 md:flex-row md:flex-wrap md:items-center">
                {resolvedLegalLinks.length > 0 && (
                  <div class="footer-legal-links flex flex-wrap items-center gap-y-2">
                    {resolvedLegalLinks.map((link, index) => (
                      <div class="contents">
                        {index > 0 && (
                          <span aria-hidden="true" class={legalSeparatorClass} />
                        )}

                        {link.action === 'openConsentSettings' || link.action === 'openDynamicEffects' ? (
                          <button
                            type="button"
                            class={legalLinkClass}
                            data-consent-settings-trigger={link.action === 'openConsentSettings' ? true : undefined}
                            data-dynamic-effects-trigger={link.action === 'openDynamicEffects' ? 'dynamic-effects-settings' : undefined}
                            aria-haspopup={link.action === 'openDynamicEffects' ? 'dialog' : undefined}
                            aria-controls={link.action === 'openDynamicEffects' ? 'dynamic-effects-settings' : undefined}
                          >
                            {link.icon && (
                              <Icon name={link.icon} size="sm" />
                            )}
                            <span>{link.label}</span>
                          </button>
                        ) : (
                          <a
                            href={link.href}
                            class={legalLinkClass}
                            target={link.external || link.href?.startsWith('http') ? '_blank' : undefined}
                            rel={link.external || link.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                          >
                            {link.icon && (
                              <Icon name={link.icon} size="sm" />
                            )}
                            <span>{link.label}</span>
                            {link.external && <Icon name="arrow-up-right" size="sm" class={externalArrowClass} aria-hidden="true" />}
                          </a>
                        )}
                      </div>
                      ))}
                  </div>
                )}
                <LanguageSwitcher placement="top" alternates={languageAlternates} />
                </div>
              </>
            )}
          </div>
        )}
      </>
    )}

    {/* FireStone: 不对称排版 Asymmetric Columns */}
    {layout === 'asymmetricColumns' && (
      <>
        <div class="flex flex-col lg:flex-row justify-between gap-12 lg:gap-8">
          {/* 左侧：Logo、描述与社交媒体 (允许在极端情况下挤压 shrink) */}
          {!hideLogo && (
            <div class="flex-none w-full lg:w-[260px] xl:w-1/4 shrink-0 space-y-[var(--space-stack-md)] pr-0 lg:pr-8">
              {hasLogoSlot ? (
                <slot name="logo" />
              ) : (
                <a href={localizedPath('/', locale)} class="flex items-center w-fit justify-self-start" aria-label={t('common.logo', locale)}>
                  <Logo size="md" class="text-foreground hdr-logo-glow" />
                </a>
              )}
              {(hasTaglineSlot || tagline) && (
                <p class="text-sm text-foreground-muted leading-relaxed">
                  {hasTaglineSlot ? <slot name="tagline" /> : tagline}
                </p>
              )}
              {/* 社交媒体：加入 flex-wrap 保证极端 4:3 屏幕下自动折行不溢出 */}
              {showSocial && socialLinks.length > 0 && (
                <div class="flex flex-col gap-3 pt-2">
                  <p class="footer-social-link-intro">{t('footer.socialMedia', locale)}</p>
                  <div class="flex flex-wrap items-center gap-[var(--space-stack-md)]">
                    {socialLinks.map((social) => (
                      <a
                        href={social.href}
                        class="transition-colors text-foreground-muted hover-glow-icon hover:text-foreground focus-visible:text-foreground"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={social.label || t('footer.followOn', locale, { platform: social.key })}
                      >
                        <Icon name={social.icon} size="md" />
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          {/* 右侧：链接组丛 (Link Groups) */}
          <div class="flex-1 flex flex-wrap justify-start lg:justify-end gap-x-6 gap-y-10 sm:gap-x-10 xl:gap-x-16 min-w-0">
            {hasColumnsSlot ? (
              <slot name="columns" />
            ) : (
              linkGroups.map((group) => (
                <div class="space-y-[var(--space-stack-md)] min-w-[120px] shrink">
                  <div class="font-semibold font-mono uppercase tracking-[0.15em] text-xs text-foreground">
                    {group.title}
                  </div>
                  <ul class="space-y-2">
                    {group.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="footer-group-link text-sm transition-colors text-foreground-muted weight-shift-non-centered hover-glow-text hover-glow-icon hover:text-foreground focus-visible:text-foreground"
                          data-text={link.label}
                          target={link.external || link.href.startsWith('http') ? '_blank' : undefined}
                          rel={link.external || link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                        >
                          <span>{link.label}</span>
                          {link.external && <Icon name="arrow-up-right" size="sm" class={externalArrowClass} aria-hidden="true" />}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            )}
          </div>
        </div>

        {/* FireStone: 巨型品牌 Logo */}
        {cleanGiantLogoSvg && (
          <div class="mt-16 w-full flex justify-center items-center pointer-events-none select-none">
            <div class="w-full [&>svg]:w-full [&>svg]:h-auto [&>svg]:text-foreground" set:html={cleanGiantLogoSvg} />
          </div>
        )}

        {/* Bottom section (版权与合规链接，复用原有逻辑) */}
        {(showCopyright || resolvedLegalLinks.length > 0) && (
          <div class="mt-[var(--space-section-header)] pt-[var(--space-section-header)] flex flex-col lg:flex-row lg:flex-wrap justify-between items-start lg:items-center gap-[var(--space-stack-md)]">
            {hasBottomSlot ? (
              <slot name="bottom" />
            ) : (
              <>
                {showCopyright && (
                  <p class="text-sm font-medium text-foreground/60" set:html={processedCopyright} />
                )}
                <div class="flex flex-col items-start gap-4 md:flex-row md:flex-wrap md:items-center">
                {resolvedLegalLinks.length > 0 && (
                  <div class="footer-legal-links flex flex-wrap items-center gap-y-2">
                    {resolvedLegalLinks.map((link, index) => (
                      <div class="contents">
                        {index > 0 && (
                          <span aria-hidden="true" class={legalSeparatorClass} />
                        )}

                        {link.action === 'openConsentSettings' || link.action === 'openDynamicEffects' ? (
                          <button
                            type="button"
                            class={legalLinkClass}
                            data-consent-settings-trigger={link.action === 'openConsentSettings' ? true : undefined}
                            data-dynamic-effects-trigger={link.action === 'openDynamicEffects' ? 'dynamic-effects-settings' : undefined}
                            aria-haspopup={link.action === 'openDynamicEffects' ? 'dialog' : undefined}
                            aria-controls={link.action === 'openDynamicEffects' ? 'dynamic-effects-settings' : undefined}
                          >
                            {link.icon && (
                              <Icon name={link.icon} size="sm" />
                            )}
                            <span>{link.label}</span>
                          </button>
                        ) : (
                          <a
                            href={link.href}
                            class={legalLinkClass}
                            target={link.external || link.href?.startsWith('http') ? '_blank' : undefined}
                            rel={link.external || link.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                          >
                            {link.icon && (
                              <Icon name={link.icon} size="sm" />
                            )}
                            <span>{link.label}</span>
                            {link.external && <Icon name="arrow-up-right" size="sm" class={externalArrowClass} aria-hidden="true" />}
                          </a>
                        )}
                      </div>
                      ))}
                  </div>
                )}
                <LanguageSwitcher placement="top" alternates={languageAlternates} />
                </div>
              </>
            )}
          </div>
        )}
      </>
    )}

    {layout === 'minimal' && (
      <div class="text-center">
        {showCopyright && (
          <p class="text-sm text-foreground-muted" set:html={processedCopyright} />
        )}
      </div>
    )}

    {layout === 'stacked' && (
      <div class="flex flex-col items-center gap-[var(--space-stack-lg)] text-center">
        {/* Logo */}
        {!hideLogo && (
          hasLogoSlot ? (
            <slot name="logo" />
          ) : (
            <a href={localizedPath('/', locale)} class="flex items-center w-fit justify-self-start" aria-label={t('common.logo', locale)}>
              <Logo size="md" class="text-foreground hdr-logo-glow" />
            </a>
          )
        )}

        {/* Tagline */}
        {(hasTaglineSlot || tagline) && (
          <p class="text-sm max-w-md text-foreground-muted">
            {hasTaglineSlot ? <slot name="tagline" /> : tagline}
          </p>
        )}

        {/* Navigation Links */}
        <nav class="flex flex-wrap justify-center gap-[var(--space-inline-lg)] text-sm font-medium text-foreground-muted">
          {allNavItems.map((item) => (
            <a
              href={item.href}
              class="inline-flex items-center gap-2 transition-colors hover-glow-icon hover:text-foreground focus-visible:text-foreground"
              target={item.external || item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.external || item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {item.label}
              {item.external && <Icon name="arrow-up-right" size="sm" class={externalArrowClass} aria-hidden="true" />}
            </a>
          ))}
        </nav>

        {/* Social Links */}
        {showSocial && socialLinks.length > 0 && (
          <div class="flex items-center gap-[var(--space-stack-md)]">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                class="transition-colors text-foreground-muted hover-glow-icon hover:text-foreground focus-visible:text-foreground"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label || t('footer.followOn', locale, { platform: social.key })}
              >
                <Icon name={social.icon} size="md" />
              </a>
            ))}
          </div>
        )}

        {/* Copyright & Legal */}
        {(showCopyright || resolvedLegalLinks.length > 0) && (
          <div class="pt-[var(--space-stack-lg)] border-t border-border w-full flex flex-col items-center gap-[var(--space-stack-md)]">
            {showCopyright && (
              <p class="text-sm text-foreground-muted" set:html={processedCopyright} />
            )}
            {resolvedLegalLinks.length > 0 && (
              <div class="flex flex-wrap justify-center items-center gap-[var(--space-inline-lg)]">
                {resolvedLegalLinks.map((link) => link.action === 'openConsentSettings' || link.action === 'openDynamicEffects' ? (
                  <button
                    type="button"
                    class="inline-flex items-center gap-2 text-sm transition-colors text-foreground-muted hover-glow-icon hover:text-foreground focus-visible:text-foreground"
                    data-consent-settings-trigger={link.action === 'openConsentSettings' ? true : undefined}
                    data-dynamic-effects-trigger={link.action === 'openDynamicEffects' ? 'dynamic-effects-settings' : undefined}
                    aria-haspopup="dialog"
                    aria-controls={link.action === 'openDynamicEffects' ? 'dynamic-effects-settings' : undefined}
                  >
                    {link.icon && <Icon name={link.icon} size="sm" />}
                    <span>{link.label}</span>
                  </button>
                ) : (
                  <a
                    href={link.href}
                    class="inline-flex items-center gap-2 text-sm transition-colors text-foreground-muted hover-glow-icon hover:text-foreground focus-visible:text-foreground"
                    target={link.external || link.href?.startsWith('http') ? '_blank' : undefined}
                    rel={link.external || link.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {link.icon && <Icon name={link.icon} size="sm" />}
                    <span>{link.label}</span>
                    {link.external && <Icon name="arrow-up-right" size="sm" class={externalArrowClass} aria-hidden="true" />}
                  </a>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    )}
  </div>

  {/* Opt-in signup stays inside the footer's mobile gutters. */}
  {siteConfig.newsletter?.enabled && (
    <div class="mx-auto mt-8 w-full max-w-lg px-6 pb-8">
      <NewsletterForm action={siteConfig.newsletter.action} heading={t('newsletter.heading', locale)} description={t('newsletter.description', locale)} layout="stacked" />
    </div>
  )}
  {/* Default slot for additional content */}
  <slot />
  <script is:inline>
    if (!window.__footerConsentSettingsBound) {
      window.__footerConsentSettingsBound = true;

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element
          ? event.target.closest('[data-consent-settings-trigger]')
          : null;

        if (!target) return;

        event.preventDefault();
        window.openConsentSettings?.();
      });
    }
  </script>

  <script>
    type FooterMotion = 'static' | 'dynamic';
    type FooterQuality = 'low' | 'high';

    const getFooterEffectState = () => {
      const root = document.documentElement;
      return {
        motion: (root.dataset.effectFooter === 'dynamic' ? 'dynamic' : 'static') as FooterMotion,
        quality: (root.dataset.effectFooterQuality === 'high' ? 'high' : 'low') as FooterQuality,
      };
    };

    const syncFooterAurora = (footer: HTMLElement) => {
      const state = getFooterEffectState();
      footer.dataset.auroraMotion = state.motion;
      footer.dataset.auroraQuality = state.quality;

      const shouldAnimate =
        state.motion === 'dynamic' &&
        footer.hasAttribute('data-aurora-in-view') &&
        !document.hidden;
      footer.toggleAttribute('data-aurora-active', shouldAnimate);
    };

    let footerAuroraObserver: IntersectionObserver | undefined;

    const initFooterAuroras = () => {
      const footers = document.querySelectorAll<HTMLElement>(
        'footer.footer-aurora:not([data-aurora-observed])'
      );

      if (footers.length === 0) return;

      if (!('IntersectionObserver' in window)) {
        footers.forEach((footer) => {
          footer.setAttribute('data-aurora-observed', '');
          footer.setAttribute('data-aurora-in-view', '');
          syncFooterAurora(footer);
        });
        return;
      }

      footerAuroraObserver ??= new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const footer = entry.target as HTMLElement;
            footer.toggleAttribute('data-aurora-in-view', entry.isIntersecting);
            syncFooterAurora(footer);
          });
        },
        { rootMargin: '160px 0px' }
      );

      footers.forEach((footer) => {
        footer.setAttribute('data-aurora-observed', '');
        syncFooterAurora(footer);
        footerAuroraObserver?.observe(footer);
      });
    };

    const refreshFooterAuroras = () => {
      document.querySelectorAll<HTMLElement>('footer.footer-aurora').forEach(syncFooterAurora);
    };

    window.addEventListener('firestone-effects-change', refreshFooterAuroras);
    document.addEventListener('visibilitychange', refreshFooterAuroras);
    document.addEventListener('astro:before-swap', () => {
      document
        .querySelectorAll<HTMLElement>('footer.footer-aurora[data-aurora-observed]')
        .forEach((footer) => footerAuroraObserver?.unobserve(footer));
    }, { once: true });
    document.addEventListener('astro:page-load', initFooterAuroras);
    initFooterAuroras();
  </script>
  
  <style is:global>
  /* Reserve the heaviest label width independently of the trailing icon. */
  footer .footer-group-link {
    display: inline-grid !important;
