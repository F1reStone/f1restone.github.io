    background:
      radial-gradient(
        ellipse 86% 68% at 4% 106%,
        rgb(0 195 255 / var(--footer-cyan-alpha)) 0%,
        rgb(0 195 255 / 0.07) 44%,
        transparent 74%
      ),
      radial-gradient(
        ellipse 92% 76% at 56% 112%,
        rgb(120 50 255 / var(--footer-purple-alpha)) 0%,
        rgb(120 50 255 / 0.1) 48%,
        transparent 76%
      ),
      radial-gradient(
        ellipse 72% 58% at 106% 94%,
        rgb(253 87 156 / var(--footer-pink-alpha)) 0%,
