    50% { transform: translate3d(-75vw, 20px, 0); }
    75% { transform: translate3d(-112.5vw, -10px, 0); }
    100% { transform: translate3d(-150vw, 20px, 0); }
  }

  @keyframes flow-pink {
    0% { transform: translate3d(0vw, -15px, 0); }
    25% { transform: translate3d(-45vw, 15px, 0); }
    50% { transform: translate3d(-90vw, -15px, 0); }
    75% { transform: translate3d(-135vw, 15px, 0); }
    100% { transform: translate3d(-180vw, -15px, 0); }
  }

  @keyframes flow-purple {
    0% { transform: translate3d(0vw, 10px, 0); }
    25% { transform: translate3d(-50vw, -20px, 0); }
    50% { transform: translate3d(-100vw, 10px, 0); }
    75% { transform: translate3d(-150vw, -20px, 0); }
    100% { transform: translate3d(-200vw, 10px, 0); }
  }

  @media (max-width: 767px) {
    .footer-aurora {
      --footer-cyan-alpha: 0.34;
      --footer-purple-alpha: 0.52;
      --footer-pink-alpha: 0.24;
      --footer-drift-opacity: 0.46;
      background:
        radial-gradient(
          ellipse 118% 64% at -8% 102%,
          rgb(0 195 255 / var(--footer-cyan-alpha)) 0%,
          rgb(0 195 255 / 0.1) 44%,
