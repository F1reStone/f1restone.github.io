    animation-delay: -14s;
  }

  .footer-aurora .aurora-blob {
    animation-play-state: paused;
  }

  .footer-aurora[data-aurora-motion='dynamic'][data-aurora-active] .aurora-blob {
    animation-play-state: running;
    will-change: transform;
  }

  .footer-aurora::before {
    content: '';
    position: absolute;
    z-index: 0;
    right: -12%;
    bottom: -12%;
    left: -12%;
    height: min(72%, 720px);
    pointer-events: none;
    transform-origin: 50% 100%;
    animation-play-state: paused;
    background:
      radial-gradient(
        ellipse 44% 76% at 12% 104%,
        rgb(0 195 255 / 0.62) 0%,
        rgb(0 195 255 / 0.18) 42%,
        transparent 74%
      ),
      radial-gradient(
        ellipse 58% 92% at 62% 112%,
        rgb(120 50 255 / 0.86) 0%,
        rgb(120 50 255 / 0.26) 44%,
        transparent 76%
      ),
      radial-gradient(
        ellipse 42% 72% at 96% 92%,
        rgb(253 87 156 / 0.58) 0%,
        rgb(253 87 156 / 0.16) 42%,
        transparent 74%
      );
    opacity: var(--footer-drift-opacity);
    animation: footer-aurora-drift 32s var(--ease-fluid) -9s infinite alternate;
    animation-play-state: paused;
  }

  .footer-aurora[data-aurora-active]::before {
    animation-play-state: running;
    will-change: transform;
  }

  .footer-aurora[data-aurora-quality='high']::before,
