  /* =========================================================================
     FireStone: Footer Aurora

     A static full-height spectrum guarantees presence at every aspect ratio.
     One compact gradient layer adds slow ambient drift only while the footer is
     near the viewport. No blur, mask, background-position, or layout property
     is animated.
     ========================================================================= */

  .footer-aurora {
