---
/**
 * SearchModal — header search trigger + Header dropdown search,
 * powered by Pagefind's static index.
 *
 * - The index is generated by the `pagefind` build hook; the Pagefind
 *   bundle is imported lazily on the first query.
 * - In `astro dev` the index does not exist; the modal explains how to
 *   build it instead of failing silently.
 * - The dialog node is portalled to <body> on init so the fixed overlay
 *   escapes the header's transform (auto-hide) and backdrop-filter.
 * - Keyboard: Cmd/Ctrl+K opens, Escape closes, ↑/↓ move through results.
 * - The panel expands from the Header's lower edge while the page remains
 *   visible through a blurred backdrop on desktop and mobile.
 */
import { t, getLocaleFromPath } from '@/i18n';
const locale = getLocaleFromPath(Astro.originPathname);
const messages = {
  hint: t('search.hint', locale),
  noResults: t('search.noResults', locale),
  unavailable: t(import.meta.env.DEV ? 'search.devNotice' : 'search.unavailable', locale),
};
import { cn } from '@/lib/cn';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const modalId = `search-modal-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class={cn('search-wrapper', className)}
  data-search-modal-id={modalId}
  data-messages={JSON.stringify(messages)}
>
  <!-- Trigger — round icon button matching the hdr-glass-pill treatment used by
       ThemeModeDropdown, ThemeSelectorDropdown and LanguageSwitcher. -->
  <button
    type="button"
    class={cn(
      'search-trigger inline-flex items-center justify-center rounded-full border border-border-strong p-1.5',
      'text-foreground-muted glass-panel hover-glow-box hover-solid-fill',
      'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'
    )}
    aria-haspopup="dialog"
    aria-controls={modalId}
    aria-expanded="false"
    aria-label={t('common.search', locale)}
  >
    <Icon name="search" size="sm" />
  </button>

  <!-- Dropdown (moved to <body> by the init script) -->
  <div
    id={modalId}
    class="search-modal pointer-events-none fixed inset-0 z-[100] hidden"
    role="dialog"
    aria-modal="true"
    aria-label={t('common.search', locale)}
    data-pagefind-ignore
  >
    <!-- The backdrop stays transparent enough to keep the page visible while
         progressively blurring it behind the dropdown. -->
    <div
      class="search-backdrop bg-background/20 fixed inset-0 opacity-0 backdrop-blur-md"
      data-search-close
      aria-hidden="true"
    >
    </div>

    <div class="search-dropdown-shell fixed inset-x-0 top-0 overflow-hidden">
      <div
        class="search-panel border-border/50 bg-background relative w-full overflow-hidden border-b shadow-2xl"
      >
        <div class="search-content mx-auto w-full max-w-6xl px-5 sm:px-8">
          <div class="search-input-row border-border/50 flex items-center gap-3 border-b">
            <!-- FireStone: 为 Search 图标添加 Tag 专属同款辉光 (drop-shadow) -->
            <Icon
              name="search"
              size="md"
              class="text-brand-500 shrink-0 opacity-95 drop-shadow-[0_0_10px_currentColor]"
            />
            <input
              id={`${modalId}-input`}
              name="q"
              type="search"
              class="search-input text-foreground placeholder:text-foreground-subtle w-full min-w-0 bg-transparent py-5 text-lg font-medium focus:outline-none sm:py-7 sm:text-2xl"
              placeholder={t('search.placeholder', locale)}
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label={t('common.search', locale)}
            />
            <button
              type="button"
              class="text-foreground-muted hover:text-foreground focus-visible:outline-ring shrink-0 rounded-full p-2 focus-visible:outline-2"
              data-search-close
              aria-label={t('common.closeDialog', locale)}
            >
              <Icon name="x" size="md" />
            </button>
          </div>

          <!-- Results (V1的大边距) -->
          <div
            class="search-results overflow-y-auto overscroll-contain p-3 sm:p-5"
            role="listbox"
            aria-label={t('search.results', locale)}
          >
            <!-- 规范化提示字号 -->
            <p class="search-hint text-foreground-muted px-3 py-10 text-center text-sm">
              {messages.hint}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .search-dropdown-shell {
    max-height: calc(100dvh - var(--search-top, 0px) - 8px);
    pointer-events: auto;
  }

  .search-panel {
    opacity: 0;
    clip-path: inset(0 0 100% 0);
  }

  .search-results {
    max-height: min(60vh, calc(100dvh - var(--search-top, 0px) - 92px));
  }

  /* 屏蔽 WebKit 原生清除按钮以防止视觉冲突 */
  .search-input::-webkit-search-cancel-button {
    display: none;
  }
</style>

<script>
  import { animateHeaderSurface, headerMotionTiming } from '@/lib/headerMotion';
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }
  interface PagefindResult {
    data: () => Promise<PagefindResultData>;
  }
  interface Pagefind {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  const MAX_RESULTS = 8;

  let pagefind: Pagefind | null = null;
  let pagefindFailed = false;

  async function loadPagefind(): Promise<Pagefind | null> {
    if (pagefind || pagefindFailed) return pagefind;
    try {
      const url = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
    } catch {
      pagefindFailed = true;
    }
    return pagefind;
  }

  function escapeHtml(text: string): string {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function initSearchModals() {
    const wrappers = document.querySelectorAll<HTMLElement>(
      '.search-wrapper:not([data-search-init])'
    );

    wrappers.forEach((wrapper) => {
      const messages = JSON.parse(wrapper.dataset.messages!);
      wrapper.dataset.searchInit = 'true';

      const trigger = wrapper.querySelector<HTMLButtonElement>('.search-trigger');
      const modal = wrapper.querySelector<HTMLElement>('.search-modal');
      if (!trigger || !modal) return;

      // Portal the dialog to <body>: the header animates with a transform
      // (auto-hide), which would turn it into the containing block for this
      // fixed overlay and drag the modal off-screen with it.
      document.body.appendChild(modal);

      const input = modal.querySelector<HTMLInputElement>('.search-input');
      const results = modal.querySelector<HTMLElement>('.search-results');
      const backdrop = modal.querySelector<HTMLElement>('.search-backdrop');
      const panel = modal.querySelector<HTMLElement>('.search-panel');
      const shell = modal.querySelector<HTMLElement>('.search-dropdown-shell');
      const row = modal.querySelector<HTMLElement>('.search-input-row');
      const header = trigger.closest<HTMLElement>('header');
      if (!input || !results || !backdrop || !panel || !shell || !row || !header) return;

      let previousActiveElement: HTMLElement | null = null;
      let isOpen = false;
      let panelAnimation: Animation | undefined;
      let backdropAnimation: Animation | undefined;
      let heightAnimation: Animation | undefined;
      let revision = 0;
      let restoreOverflow = '';
      let restoreGutter = '';
      const inactive = new Map<HTMLElement, boolean>();
      const events = new AbortController();

      const setHeaderExpanded = (expanded: boolean) => {
        animateHeaderSurface(header, 'data-search-expanded', expanded);
      };

      const restorePage = () => {
        document.body.style.overflow = restoreOverflow;
        document.documentElement.style.scrollbarGutter = restoreGutter;
        inactive.forEach((wasInert, element) => {
          element.inert = wasInert;
        });
        inactive.clear();
      };

      const setLayout = () => {
        const viewport = window.visualViewport;
        const viewportTop = viewport?.offsetTop ?? 0;
        const viewportHeight = viewport?.height ?? window.innerHeight;
        const headerBox = header.getBoundingClientRect();
        const top = Math.max(viewportTop, headerBox.bottom);
        // Leave visible page beneath the search, even with the software keyboard up.
        const gap = Math.min(64, viewportHeight * 0.12);
        const availableHeight = Math.max(0, viewportTop + viewportHeight - top - gap);
        shell.style.setProperty('--search-top', `${top}px`);
        shell.style.top = `${top}px`;
        shell.style.maxHeight = `${availableHeight}px`;
        const floating = header.dataset.headerShape === 'floating';
        shell.style.left = floating ? `${headerBox.left}px` : '0';
        shell.style.right = floating ? `${window.innerWidth - headerBox.right}px` : '0';
        results.style.maxHeight = `${Math.max(0, Math.min(viewportHeight * 0.6, availableHeight - row.offsetHeight - 1))}px`;
        heightAnimation?.cancel();
      };

      const onViewportChange = () => {
        if (isOpen) setLayout();
      };

      const animateSurface = (opening: boolean) => {
        const panelStyle = getComputedStyle(panel);
        const backdropStyle = getComputedStyle(backdrop);
        const currentClip =
          panelStyle.clipPath === 'none' ? 'inset(0 0 0% 0)' : panelStyle.clipPath;
        const fromPanel = { opacity: panelStyle.opacity, clipPath: currentClip };
        const fromBackdrop = { opacity: backdropStyle.opacity };
        panelAnimation?.cancel();
        backdropAnimation?.cancel();

        const timing = headerMotionTiming();
        panelAnimation = panel.animate(
          [
            fromPanel,
            {
              opacity: opening ? 1 : 0,
              clipPath: opening ? 'inset(0 0 0% 0)' : 'inset(0 0 100% 0)',
            },
          ],
          timing
        );
        backdropAnimation = backdrop.animate([fromBackdrop, { opacity: opening ? 1 : 0 }], timing);
        return Promise.all([panelAnimation.finished, backdropAnimation.finished]);
      };

      const updateHtmlSmoothly = (html: string) => {
        const startHeight = panel.getBoundingClientRect().height;
        heightAnimation?.cancel();
        results.innerHTML = html;
        const targetHeight = panel.offsetHeight;
        if (!isOpen || startHeight === targetHeight) return;
        heightAnimation = panel.animate(
          [{ height: `${startHeight}px` }, { height: `${targetHeight}px` }],
          {
            ...headerMotionTiming(),
            duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 600,
            fill: 'none',
          }
        );
      };

      // ── Open / Close ──────────────────────────────────────────────────

      const open = () => {
        if (isOpen) return;
        revision++;
        if (modal.classList.contains('hidden')) {
          previousActiveElement = document.activeElement as HTMLElement;
          restoreOverflow = document.body.style.overflow;
          restoreGutter = document.documentElement.style.scrollbarGutter;
          document.documentElement.style.scrollbarGutter = 'stable';
          document.body.style.overflow = 'hidden';
          for (const element of document.body.children) {
            if (
              !(element instanceof HTMLElement) ||
              element === modal ||
              element.contains(header) ||
              element.matches('script, style, link')
            )
              continue;
            inactive.set(element, element.inert);
            element.inert = true;
          }
        }
        isOpen = true;
        header.setAttribute('data-search-active', '');
        header.removeAttribute('data-header-hidden');
        setHeaderExpanded(true);
        header.dispatchEvent(new Event('header:search-open'));
        modal.classList.remove('hidden');
        modal.style.pointerEvents = 'auto';
        modal.inert = false;
        modal.dataset.searchOpen = 'true';
        trigger.setAttribute('aria-expanded', 'true');
        setLayout();
        void animateSurface(true).catch(() => {});
        // Stay inside the user gesture so iOS can open its software keyboard.
        input.focus({ preventScroll: true });
        input.select();
      };

      const close = () => {
        if (!isOpen) return;
        const closingRevision = ++revision;
        isOpen = false;
        setHeaderExpanded(false);
        modal.dataset.searchOpen = 'false';
        trigger.setAttribute('aria-expanded', 'false');
        if (
          document.activeElement instanceof HTMLElement &&
          modal.contains(document.activeElement)
        ) {
          trigger.focus({ preventScroll: true });
        }
        modal.inert = true;
        void animateSurface(false).then(
          () => {
            if (isOpen || revision !== closingRevision) return;
            modal.classList.add('hidden');
            modal.style.pointerEvents = 'none';
            modal.inert = true;
            header.removeAttribute('data-search-active');
            restorePage();
            if (document.activeElement === trigger && previousActiveElement?.isConnected) {
              previousActiveElement.focus({ preventScroll: true });
            }
          },
          () => {}
        );
      };

      modal.inert = true;
      window.addEventListener('resize', onViewportChange, { passive: true, signal: events.signal });
      window.visualViewport?.addEventListener('resize', onViewportChange, {
        passive: true,
        signal: events.signal,
      });
      window.visualViewport?.addEventListener('scroll', onViewportChange, {
        passive: true,
        signal: events.signal,
      });
      window.addEventListener('scroll', onViewportChange, { passive: true, signal: events.signal });
      const headerObserver = new ResizeObserver(onViewportChange);
      headerObserver.observe(header);
      header.addEventListener('header:menu-open', close, { signal: events.signal });

      // ── Focus trap (mirrors Dialog.astro) ────────────────────────────

      function getFocusableElements(): HTMLElement[] {
        return Array.from(
          panel?.querySelectorAll<HTMLElement>(
            'button, a[href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          ) || []
        ).filter((el) => el instanceof HTMLElement && el.tabIndex >= 0 && !el.hasAttribute('disabled'));
      }

      function trapFocus(e: KeyboardEvent) {
        if (e.key !== 'Tab') return;

        const focusable = getFocusableElements();
        if (focusable.length === 0) return;

        const firstFocusable = focusable[0];
        const lastFocusable = focusable[focusable.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === firstFocusable) {
            e.preventDefault();
            lastFocusable.focus();
          }
        } else {
          if (document.activeElement === lastFocusable) {
            e.preventDefault();
            firstFocusable.focus();
          }
        }
      }

      // ── Search logic ─────────────────────────────────────────────────

      const renderMessage = (html: string) => {
        updateHtmlSmoothly(
          `<p class="px-3 py-10 text-center text-sm text-foreground-muted">${html}</p>`
        );
      };

      const renderResults = async (query: string) => {
        const pf = await loadPagefind();
        if (!pf) {
          renderMessage(escapeHtml(messages.unavailable));
          return;
        }

        const search = await pf.search(query);
        // A newer keystroke may have superseded this query while we awaited
        if (input.value.trim() !== query) return;

        if (search.results.length === 0) {
          renderMessage(escapeHtml(messages.noResults).replace('{query}', escapeHtml(query)));
          return;
        }

        const items = await Promise.all(search.results.slice(0, MAX_RESULTS).map((r) => r.data()));
        if (input.value.trim() !== query) return;

        // FireStone: V1的舒适间距 + V2的标准字号规范 (text-sm, text-xs)
        const resultsHtml = items
          .map(
            (item) => `
              <a
                href="${item.url}"
                class="search-result block rounded-xl px-4 py-3 mb-1 hover:bg-secondary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring transition-colors"
                role="option"
              >
                <span class="block text-sm font-bold text-foreground">${escapeHtml(item.meta.title ?? item.url)}</span>
                <span class="mt-1 block text-xs leading-relaxed text-foreground-muted [&_mark]:bg-transparent [&_mark]:text-brand-500 [&_mark]:font-bold">${item.excerpt}</span>
              </a>`
          )
          .join('');

        updateHtmlSmoothly(resultsHtml);
      };

      let debounce: number | undefined;
      input.addEventListener('input', () => {
        if (debounce) window.clearTimeout(debounce);
        const query = input.value.trim();
        if (!query) {
          renderMessage(escapeHtml(messages.hint));
          return;
        }
        debounce = window.setTimeout(() => renderResults(query), 150);
      });

      // ── Event listeners ──────────────────────────────────────────────

      trigger.addEventListener('click', () => (isOpen ? close() : open()));
      modal.querySelectorAll('[data-search-close]').forEach((el) => {
        el.addEventListener('click', close);
      });

      // ↑/↓ between input and results, Escape to close
      modal.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
          return;
        }
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        const links = Array.from(modal.querySelectorAll<HTMLAnchorElement>('.search-result'));
        if (links.length === 0) return;
        e.preventDefault();
        const active = document.activeElement;
        const index = links.indexOf(active as HTMLAnchorElement);
        if (e.key === 'ArrowDown') {
          (index === -1 ? links[0] : links[Math.min(index + 1, links.length - 1)]).focus();
        } else if (index <= 0) {
          input.focus();
        } else {
          links[index - 1].focus();
        }
      });

      // Focus trap on Tab
      modal.addEventListener('keydown', trapFocus);
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && isOpen) close();
        },
        { signal: events.signal }
      );

      const w = window as unknown as { __searchToggle?: () => void };
      w.__searchToggle = () => (isOpen ? close() : open());
      document.addEventListener(
        'astro:before-swap',
        () => {
          events.abort();
          headerObserver.disconnect();
          window.clearTimeout(debounce);
          panelAnimation?.cancel();
          backdropAnimation?.cancel();
          heightAnimation?.cancel();
          if (!modal.classList.contains('hidden')) restorePage();
          modal.remove();
          w.__searchToggle = undefined;
        },
        { once: true }
      );
    });

    // ── Cmd/Ctrl+K global hotkey ─────────────────────────────────────
    // Bound once per session. Uses the live DOM so it survives view-
    // transition swaps. Uses the same animated open/close as the trigger.

    const w = window as unknown as { __searchHotkeyInit?: boolean; __searchToggle?: () => void };
    if (!w.__searchHotkeyInit) {
      w.__searchHotkeyInit = true;
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'k') return;
        e.preventDefault();
        w.__searchToggle?.();
      });
    }
  }

  initSearchModals();
  document.addEventListener('astro:page-load', initSearchModals);
  document.addEventListener('astro:after-swap', initSearchModals);
</script>
