---
/**
 * SearchModal — header search trigger + command-palette style modal,
 * powered by Pagefind's static index.
 *
 * - The index is generated at build time by the `pagefind` hook in
 *   `astro.config.mjs`, so search ships zero JS until the modal is opened —
 *   the Pagefind bundle (~6 kB) is imported lazily on first open.
 * - In `astro dev` the index does not exist; the modal explains how to
 *   build it instead of failing silently.
 * - The dialog node is portalled to <body> on init so the fixed overlay
 *   escapes the header's transform (auto-hide) and backdrop-filter.
 * - Keyboard: Cmd/Ctrl+K opens, Escape closes, ↑/↓ move through results.
 * - Visuals and animations are aligned with the site's true Dialog component
 *   (src/components/ui/overlay/Dialog/Dialog.astro).
 */
import { cn } from '@/lib/cn';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const modalId = `search-modal-${Math.random().toString(36).slice(2, 9)}`;
---

<div class={cn('search-wrapper', className)} data-search-modal-id={modalId}>
  <!-- Trigger — round icon button matching the hdr-glass-pill treatment used by
       ThemeModeDropdown, ThemeSelectorDropdown and LanguageSwitcher. -->
  <button
    type="button"
    class={cn(
      'search-trigger inline-flex items-center justify-center rounded-full border border-border-strong p-1.5',
      'text-foreground-muted glass-panel hover-glow-box hover-solid-fill',
      'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'
    )}
    aria-haspopup="dialog"
    aria-controls={modalId}
    aria-label="搜索"
  >
    <Icon name="search" size="sm" />
  </button>

  <!-- Modal (moved to <body> by the init script) -->
  <div
    id={modalId}
    class="search-modal fixed inset-0 z-[100] hidden"
    role="dialog"
    aria-modal="true"
    aria-label="搜索"
    data-pagefind-ignore
  >
    <!-- FireStone: 统一步调的高级毛玻璃遮罩 -->
    <div
      class="search-backdrop fixed inset-0 bg-background/40 backdrop-blur-md opacity-0 transition-opacity duration-300 ease-[var(--ease-default)]"
      data-search-close
      aria-hidden="true"
    ></div>

    <!-- Panel — command-palette positioned (top, not center), but shadow +
         animation mechanics mirror Dialog.astro (shadow-xl, scale-95→100). -->
    <!-- FireStone: 移动端防软键盘遮挡 (pt-16)，桌面端黄金下沉比例 (12vh) -->
    <div class="fixed inset-0 flex justify-center items-start overflow-y-auto p-4 pt-16 sm:pt-[12vh]">
      <!-- FireStone: 融合 V1 的大尺寸毛玻璃与 V2 的 transition-all (复活缩放) -->
      <div
        class="search-panel relative w-full max-w-2xl overflow-hidden rounded-3xl border border-border/50 bg-background/80 shadow-2xl backdrop-blur-lg scale-95 opacity-0 transition-all duration-300 ease-[var(--ease-default)]"
      >
        <!-- Input row -->
        <div class="flex items-center gap-3 border-b border-border/50 px-5">
          <!-- FireStone: 为 Search 图标添加 Tag 专属同款辉光 (drop-shadow) -->
          <Icon name="search" size="md" class="text-brand-500 shrink-0 drop-shadow-[0_0_10px_currentColor] opacity-95" />
          <input
            type="search"
            class="search-input w-full bg-transparent py-5 text-base font-medium text-foreground placeholder:text-foreground-subtle focus:outline-none"
            placeholder="搜索文章、项目或关键字..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            role="searchbox"
            aria-label="搜索查询"
          />
          <button
            type="button"
            class="shrink-0 rounded-lg border border-border/50 bg-transparent px-2 py-1 text-[10px] font-mono font-bold uppercase text-foreground-muted hover:text-foreground hover:border-foreground hover:drop-shadow-[0_0_8px_currentColor] transition-all duration-300"
            data-search-close
            aria-label="按下 Esc 以关闭搜索"
          >
            Esc
          </button>
        </div>

        <!-- Results (V1的大边距) -->
        <div
          class="search-results max-h-[60vh] overflow-y-auto overscroll-contain p-3"
          role="listbox"
          aria-label="搜索结果"
        >
          <!-- 规范化提示字号 -->
          <p class="search-hint px-3 py-10 text-center text-sm text-foreground-muted">
            输入关键字以开始在网站上搜索。
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* 屏蔽 WebKit 原生清除按钮以防止视觉冲突 */
  .search-input::-webkit-search-cancel-button {
    display: none;
  }
</style>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }
  interface PagefindResult {
    data: () => Promise<PagefindResultData>;
  }
  interface Pagefind {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  const MAX_RESULTS = 8;

  let pagefind: Pagefind | null = null;
  let pagefindFailed = false;

  async function loadPagefind(): Promise<Pagefind | null> {
    if (pagefind || pagefindFailed) return pagefind;
    try {
      const url = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
    } catch {
      pagefindFailed = true;
    }
    return pagefind;
  }

  function escapeHtml(text: string): string {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function initSearchModals() {
    const wrappers = document.querySelectorAll<HTMLElement>(
      '.search-wrapper:not([data-search-init])'
    );

    wrappers.forEach((wrapper) => {
      wrapper.dataset.searchInit = 'true';

      const trigger = wrapper.querySelector<HTMLButtonElement>('.search-trigger');
      const modal = wrapper.querySelector<HTMLElement>('.search-modal');
      if (!trigger || !modal) return;

      // Portal the dialog to <body>: the header animates with a transform
      // (auto-hide), which would turn it into the containing block for this
      // fixed overlay and drag the modal off-screen with it.
      document.body.appendChild(modal);

      const input = modal.querySelector<HTMLInputElement>('.search-input');
      const results = modal.querySelector<HTMLElement>('.search-results');
      const backdrop = modal.querySelector<HTMLElement>('.search-backdrop');
      const panel = modal.querySelector<HTMLElement>('.search-panel');
      if (!input || !results || !backdrop || !panel) return;

      let previousActiveElement: HTMLElement | null = null;
      let isAnimating = false;

      // ── FireStone: 终极平滑高度重算 (Smooth Height Resizing with Safety Guard) ──
      const updateHtmlSmoothly = (html: string) => {
        // 1. 冻结当前高度
        const startHeight = panel.offsetHeight;
        panel.style.height = `${startHeight}px`;

        // 2. 注入新内容
        results.innerHTML = html;

        // 3. 计算注入后应有的自然高度
        panel.style.height = 'auto';
        const targetHeight = panel.offsetHeight;

        // 安全锁：如果高度没有变化，直接返回，防止 transitionend 死锁
        if (startHeight === targetHeight) {
          return;
        }

        // 4. 退回起始高度，强制浏览器渲染帧 (Reflow)
        panel.style.height = `${startHeight}px`;
        void panel.offsetHeight;

        // 5. 应用目标高度，触发 transition-all 统一动画
        panel.style.height = `${targetHeight}px`;

        // 6. 动画结束后清理行内样式，保证窗口 Resize 的响应式弹性
        const cleanup = (e: TransitionEvent) => {
          if (e.target === panel && e.propertyName === 'height') {
            panel.style.height = 'auto';
            panel.removeEventListener('transitionend', cleanup);
          }
        };
        panel.addEventListener('transitionend', cleanup);
      };

      // ── Open / Close ──────────────────────────────────────────────────

      const open = () => {
        if (isAnimating) return;
        isAnimating = true;

        previousActiveElement = document.activeElement as HTMLElement;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        requestAnimationFrame(() => {
          backdrop.classList.add('opacity-100');
          panel.classList.remove('scale-95', 'opacity-0');
          panel.classList.add('scale-100', 'opacity-100');

          input.focus();
          input.select();
          isAnimating = false;
        });
      };

      const close = () => {
        if (isAnimating) return;
        isAnimating = true;

        backdrop.classList.remove('opacity-100');
        panel.classList.add('scale-95', 'opacity-0');
        panel.classList.remove('scale-100', 'opacity-100');

        // FireStone: 严格匹配 duration-300，防止抽帧
        setTimeout(() => {
          modal.classList.add('hidden');
          document.body.style.overflow = '';

          // Restore focus without scrolling — prevents the bug where
          // closing search scrolls the page up to the header trigger.
          previousActiveElement?.focus({ preventScroll: true });

          isAnimating = false;
        }, 300);
      };

      // ── Focus trap (mirrors Dialog.astro) ────────────────────────────

      function getFocusableElements(): HTMLElement[] {
        return Array.from(
          panel?.querySelectorAll<HTMLElement>(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          ) || []
        ).filter((el) => !el.hasAttribute('disabled'));
      }

      function trapFocus(e: KeyboardEvent) {
        if (e.key !== 'Tab') return;

        const focusable = getFocusableElements();
        if (focusable.length === 0) return;

        const firstFocusable = focusable[0];
        const lastFocusable = focusable[focusable.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === firstFocusable) {
            e.preventDefault();
            lastFocusable.focus();
          }
        } else {
          if (document.activeElement === lastFocusable) {
            e.preventDefault();
            firstFocusable.focus();
          }
        }
      }

      // ── Search logic ─────────────────────────────────────────────────

      const renderMessage = (html: string) => {
        updateHtmlSmoothly(`<p class="px-3 py-10 text-center text-sm text-foreground-muted">${html}</p>`);
      };

      const renderResults = async (query: string) => {
        const pf = await loadPagefind();
        if (!pf) {
          renderMessage(
            '搜索索引是在构建时生成的，在 <code class="rounded-md border border-border/50 bg-secondary px-1.5 py-0.5 text-xs">astro dev</code> 中不可用。<br />运行 <code class="rounded-md border border-border/50 bg-secondary px-1.5 py-0.5 text-xs mt-2 inline-block">pnpm build &amp;&amp; pnpm preview</code> 以在本地尝试。'
          );
          return;
        }

        const search = await pf.search(query);
        // A newer keystroke may have superseded this query while we awaited
        if (input.value.trim() !== query) return;

        if (search.results.length === 0) {
          renderMessage(`没有找到关于「<span class="text-foreground font-semibold">${escapeHtml(query)}</span>」的结果。`);
          return;
        }

        const items = await Promise.all(
          search.results.slice(0, MAX_RESULTS).map((r) => r.data())
        );

        // FireStone: V1的舒适间距 + V2的标准字号规范 (text-sm, text-xs)
        const resultsHtml = items
          .map(
            (item) => `
              <a
                href="${item.url}"
                class="search-result block rounded-xl px-4 py-3 mb-1 hover:bg-secondary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring transition-colors"
                role="option"
              >
                <span class="block text-sm font-bold text-foreground">${escapeHtml(item.meta.title ?? item.url)}</span>
                <span class="mt-1 block text-xs leading-relaxed text-foreground-muted [&_mark]:bg-transparent [&_mark]:text-brand-500 [&_mark]:font-bold">${item.excerpt}</span>
              </a>`
          )
          .join('');

        updateHtmlSmoothly(resultsHtml);
      };

      let debounce: number | undefined;
      input.addEventListener('input', () => {
        if (debounce) window.clearTimeout(debounce);
        const query = input.value.trim();
        if (!query) {
          renderMessage('输入关键字以开始在网站上搜索。');
          return;
        }
        debounce = window.setTimeout(() => renderResults(query), 150);
      });

      // ── Event listeners ──────────────────────────────────────────────

      trigger.addEventListener('click', open);
      modal.querySelectorAll('[data-search-close]').forEach((el) => {
        el.addEventListener('click', close);
      });

      // ↑/↓ between input and results, Escape to close
      modal.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
          return;
        }
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        const links = Array.from(modal.querySelectorAll<HTMLAnchorElement>('.search-result'));
        if (links.length === 0) return;
        e.preventDefault();
        const active = document.activeElement;
        const index = links.indexOf(active as HTMLAnchorElement);
        if (e.key === 'ArrowDown') {
          (index === -1 ? links[0] : links[Math.min(index + 1, links.length - 1)]).focus();
        } else if (index <= 0) {
          input.focus();
        } else {
          links[index - 1].focus();
        }
      });

      // Focus trap on Tab
      modal.addEventListener('keydown', trapFocus);

    });

    // ── Cmd/Ctrl+K global hotkey ─────────────────────────────────────
    // Bound once per session. Uses the live DOM so it survives view-
    // transition swaps. Uses the same animated open/close as the trigger.

    const w = window as unknown as { __searchHotkeyInit?: boolean };
    if (!w.__searchHotkeyInit) {
      w.__searchHotkeyInit = true;
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'k') return;
        const modal = document.querySelector<HTMLElement>('.search-modal');
        if (!modal) return;
        e.preventDefault();

        const backdrop = modal.querySelector<HTMLElement>('.search-backdrop');
        const panel = modal.querySelector<HTMLElement>('.search-panel');
        const input = modal.querySelector<HTMLInputElement>('.search-input');

        if (modal.classList.contains('hidden')) {
          // Animated open — mirrors the trigger's open()
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';

          requestAnimationFrame(() => {
            backdrop?.classList.add('opacity-100');
            panel?.classList.remove('scale-95', 'opacity-0');
            panel?.classList.add('scale-100', 'opacity-100');
            input?.focus();
            input?.select();
          });
        } else {
          // Animated close — mirrors the trigger's close()
          backdrop?.classList.remove('opacity-100');
          panel?.classList.add('scale-95', 'opacity-0');
          panel?.classList.remove('scale-100', 'opacity-100');

          setTimeout(() => {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
        }
      });
    }
  }

  initSearchModals();
  document.addEventListener('astro:page-load', initSearchModals);
  document.addEventListener('astro:after-swap', initSearchModals);
</script>
