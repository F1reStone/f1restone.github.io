---
/**
 * LanguageSwitcher
 *
 * Pill dropdown that lists every configured locale and links to the
 * "same page, other language" URL for each. The default locale lives
 * at the site root (no prefix); additional locales live under `/<locale>/`.
 *
 * Renders nothing when i18n is disabled or only one locale is
 * configured, so it has zero cost on single-locale sites.
 *
 * Pure HTML <a> links — no JS framework, no client-side routing.
 * The only script is for opening/closing the dropdown panel.
 */
import { cn } from '@/lib/cn';
import {
  isEnabled as i18nIsEnabled,
  getLocales,
  getLocaleName,
  getLocaleFromPath,
  swapLocaleInPath,
  t,
} from '@/i18n';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  class?: string;
  /** Render compact (icon-only trigger). Defaults to false. */
  compact?: boolean;
  /** Footer menus open above the trigger to stay inside the page. */
  placement?: 'top' | 'bottom';
  /**
   * Optional map of `locale -> URL` for "same content, other language" links.
   * When provided (e.g. by a blog post that knows its real per-locale URLs),
   * it overrides the default behaviour of swapping the locale segment of the
   * current path — which is wrong when a translation lives at a different slug.
   * Locales missing from the map are omitted.
   */
  alternates?: Record<string, string>;
}

const { class: className, compact = false, placement = 'bottom', alternates } = Astro.props;

const enabled = i18nIsEnabled();
const currentPath = Astro.originPathname;
const currentLocale = getLocaleFromPath(currentPath);
const resolvedAlternates = alternates ?? Object.fromEntries(getLocales().map(locale => [locale, swapLocaleInPath(currentPath, locale)]));
const locales = enabled ? getLocales().filter(locale => Boolean(resolvedAlternates[locale])) : [];

const triggerLabel = t('nav.selectLanguage', currentLocale);
const currentLanguageLabel = t('nav.currentLanguage', currentLocale);
---

{
  enabled && (
    <div class={cn('relative lang-wrapper', className)} data-placement={placement}>
      <button
        type="button"
        class={cn(
          'lang-trigger inline-flex items-center gap-1.5 rounded-full border border-border-strong px-2.5 py-1.5',
          'text-foreground-secondary glass-panel hover-glow-box hover-solid-fill',
          'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'
        )}
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label={`${currentLanguageLabel}: ${getLocaleName(currentLocale)}. ${triggerLabel}.`}
      >
        <span class="ttg-icon ttg-icon-light h-4 w-4" aria-hidden="true">
          <Icon name="languages" size="sm" />
        </span>
        {!compact && (
          <span class="text-xs font-semibold uppercase tracking-wide">{getLocaleName(currentLocale)}</span>
        )}
        <svg
          class="lang-chevron h-3 w-3 flex-shrink-0 transition-transform duration-200 motion-reduce:transition-none"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>

      <div
        class={cn(
          'lang-panel absolute z-50',
          placement === 'top' ? 'left-0 bottom-full mb-2 md:left-auto md:right-0' : 'right-0 top-full mt-2',
          'w-48 rounded-3xl border border-border/10 bg-background/50 backdrop-blur-md shadow-xl',
          'p-1.5 hidden'
        )}
        role="menu"
        aria-label={triggerLabel}
      >
        {locales.map((locale) => {
          const href = resolvedAlternates[locale];
          const isActive = locale === currentLocale;
          return (
            <a
              href={href}
              hreflang={locale}
              lang={locale}
              class="lang-row"
              role="menuitemradio"
              aria-checked={isActive ? 'true' : 'false'}
              data-locale={locale}
            >
              <span class="lang-row-code">{locale.toUpperCase()}</span>
              <span class="lang-row-name">{getLocaleName(locale)}</span>
              <svg
                class="lang-check h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6L9 17l-5-5" />
              </svg>
            </a>
          );
        })}
      </div>
    </div>
  )
}

<style>
  .lang-wrapper[data-placement='top'] .lang-trigger[aria-expanded='false'] .lang-chevron,
  .lang-wrapper[data-placement='bottom'] .lang-trigger[aria-expanded='true'] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    text-align: left;
    padding: 0.5rem 0.625rem;
    border-radius: 1rem;
    color: var(--color-foreground-muted);
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .lang-row:hover {
    background-color: color-mix(in oklab, var(--color-foreground-muted) 15%, transparent);
    color: var(--color-foreground);
  }

  .lang-row:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: -2px;
  }

  .lang-row[aria-checked='true'] {
    background-color: color-mix(in oklab, var(--color-foreground-muted) 15%, transparent);
    color: var(--color-foreground);
  }

  .lang-row-code {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-foreground-muted);
    min-width: 1.75rem;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .lang-row[aria-checked='true'] .lang-row-code {
    color: var(--color-foreground);
  }

  .lang-row:hover .lang-row-code {
    color: var(--color-foreground);
  }

  .lang-row:focus-visible .lang-row-code {
    color: var(--color-foreground);
  }

  .lang-row-name {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .lang-check {
    display: none;
    color: var(--color-foreground);
  }

  .lang-row[aria-checked='true'] .lang-check {
    display: block;
  }
</style>

<script>
  function closeAllLangPanels(): void {
    document.querySelectorAll<HTMLElement>('.lang-panel').forEach((p) => p.classList.add('hidden'));
    document.querySelectorAll<HTMLButtonElement>('.lang-trigger').forEach((t) => {
      t.setAttribute('aria-expanded', 'false');
    });
  }

  function initLanguageSwitcher(): void {
    const wrappers = document.querySelectorAll<HTMLElement>('.lang-wrapper');
    if (!wrappers.length) return;

      document.querySelectorAll('.lang-row').forEach((row) => {
      row.addEventListener('click', () => {
        const locale = row.getAttribute('data-locale');
        if (locale) {
          try { localStorage.setItem('preferred_locale', locale); } catch { /* Storage may be unavailable. */ }
        }
      });
    });

    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.langInit) return;
      wrapper.dataset.langInit = 'true';

      const trigger = wrapper.querySelector<HTMLButtonElement>('.lang-trigger');
      const panel = wrapper.querySelector<HTMLElement>('.lang-panel');
      if (!trigger || !panel) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = panel.classList.contains('hidden');
        closeAllLangPanels();
        if (willOpen) {
          panel.classList.remove('hidden');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });

    if (!(window as unknown as { __langGlobalInit?: boolean }).__langGlobalInit) {
      (window as unknown as { __langGlobalInit?: boolean }).__langGlobalInit = true;

      document.addEventListener('click', (e) => {
        const open = document.querySelector<HTMLElement>('.lang-panel:not(.hidden)');
        if (!open) return;
        const wrapper = open.closest('.lang-wrapper');
        if (wrapper && !wrapper.contains(e.target as Node)) closeAllLangPanels();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const open = document.querySelector<HTMLElement>('.lang-panel:not(.hidden)');
          if (!open) return;
          const trigger = open.closest('.lang-wrapper')?.querySelector<HTMLButtonElement>('.lang-trigger');
          closeAllLangPanels();
          trigger?.focus();
        }
      });
    }
  }

  initLanguageSwitcher();
  document.addEventListener('astro:page-load', initLanguageSwitcher);
  document.addEventListener('astro:after-swap', initLanguageSwitcher);
</script>
