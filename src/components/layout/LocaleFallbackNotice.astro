---
import { getLocaleFromPath, localizedPath, t } from '@/i18n';
import { getLocaleFallback } from '@/lib/locale-fallback';
import Button from '@/components/ui/form/Button';
import Icon from '@/components/ui/primitives/Icon';
import {
  bannerPanelClass,
  bannerContentClass,
  bannerHeadingClass,
  bannerDescriptionClass,
  bannerActionsClass,
} from '@/components/ui/overlay/FloatingBanner/styles';
import '@/components/ui/overlay/FloatingBanner/animation.css';

const fallback = getLocaleFallback(
  Astro.originPathname,
  Astro.url.pathname,
  Astro.locals.contentLocale
);
const locale = getLocaleFromPath(Astro.originPathname);
const language = fallback
  ? (new Intl.DisplayNames([locale], { type: 'language' }).of(fallback.contentLocale) ??
    fallback.contentLocale)
  : '';
---

{
  fallback && (
    <section
      class:list={[bannerPanelClass, 'floating-banner--visible']}
      data-locale-fallback
      lang={locale}
      aria-labelledby="locale-fallback-heading"
      data-pagefind-ignore
    >
      <div class={bannerContentClass}>
        <p id="locale-fallback-heading" class={bannerHeadingClass}>
          {t('localeFallback.heading', locale)}
        </p>
        <p class={bannerDescriptionClass}>{t('localeFallback.page', locale, { language })}</p>
      </div>
      <div class={bannerActionsClass}>
        <Button variant="primary" size="sm" data-dismiss-fallback>
          <Icon name="check" size="sm" />
          {t('localeFallback.confirm', locale)}
        </Button>
        <Button variant="secondary" size="sm" href={localizedPath('/', locale)}>
          <Icon name="house" size="sm" />
          {t('localeFallback.backToHome', locale)}
        </Button>
      </div>
    </section>
  )
}

<script>
  import { hideFloatingBanner } from '@/components/ui/overlay/FloatingBanner/visibility';
  function initFallbackNotice() {
    const notice = document.querySelector<HTMLElement>('[data-locale-fallback]');
    if (!notice || notice.dataset.dismissInit) return;
    notice.dataset.dismissInit = 'true';
    notice?.querySelector('[data-dismiss-fallback]')?.addEventListener('click', () => {
      void hideFloatingBanner(notice);
    });
    notice.querySelector('a')?.addEventListener('click', async (event) => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
        return;
      event.preventDefault();
      const href = (event.currentTarget as HTMLAnchorElement).href;
      await hideFloatingBanner(notice);
      window.location.assign(href);
    });
  }
  initFallbackNotice();
  document.addEventListener('astro:page-load', initFallbackNotice);
</script>
