---
/**
 * Header Component
 * Flexible navigation header with variant-based configuration
 *
 * Variants:
 * - layout: 'default' | 'centered' | 'minimal'
 * - position: 'fixed' | 'sticky' | 'static'
 * - size: 'sm' | 'md' | 'lg'
 * - variant: 'default' | 'solid' | 'transparent' | 'progressive'
 * - colorScheme: 'default' | 'invert' (use 'invert' for dark backgrounds)
 * - shape: 'bar' | 'floating' (use 'floating' for capsule header)
 *
 * Features:
 * - Dynamic navigation from nav.config.ts (default) or custom nav prop
 * - Optional CTA button with customization
 * - Mobile menu with Escape key support
 * - Theme toggle
 * - GitHub/action buttons
 * - Full slot support for customization
 * - Inverted color scheme for use on dark/image backgrounds
 * - Floating capsule shape with scroll-reactive bg + color flip
 */
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import { cn } from '@/lib/cn';
import { resolveSocialLinks } from '@/lib/utils';
import { getNavItems, type ResolvedNavItem } from '@/config/nav.config';
import { headerVariants, headerInnerVariants } from './header.variants';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Logo from '@/components/ui/marketing/Logo/Logo.astro';
import SearchModal from '@/components/layout/SearchModal.astro';
import ThemeModeDropdown from '@/components/layout/ThemeModeDropdown.astro';
import ThemeSelector from '@/components/layout/ThemeSelector.astro';
import ThemeSelectorDropdown from '@/components/layout/ThemeSelectorDropdown.astro';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import siteConfig from '@/config/site.config';
import { getLocaleFromPath, t, localizedPath, stripLocaleFromPath } from '@/i18n';
const locale = getLocaleFromPath(Astro.originPathname);

export interface NavItem {
  label: string;
  href: string;
}

export interface HeaderAction {
  icon: string;
  href: string;
  label: string;
  iconOnly?: boolean;
  target?: string;
}

interface Props extends HTMLAttributes<'header'> {
  layout?: 'default' | 'centered' | 'minimal';
  position?: 'fixed' | 'sticky' | 'static';
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  variant?: 'default' | 'solid' | 'transparent' | 'progressive';
  colorScheme?: 'default' | 'invert';
  shape?: 'bar' | 'floating';
  nav?: NavItem[];
  extraNav?: NavItem[];
  showCta?: boolean;
  cta?: { label?: string; href?: string; icon?: string; trailingIcon?: string };
  actions?: HeaderAction[];
  showSearch?: boolean;
  showThemeToggle?: boolean;
  showThemeSelector?: boolean;
  showMobileMenu?: boolean;
  showActiveState?: boolean;
  hideLogo?: boolean;
  /**
   * Optional secondary logo rendered to the right of the main site logo.
   * The two logos are separated by a subtle vertical divider.
   *
   * **Chameleon pattern (preferred):** Pass `secondaryLogoSvg` with the raw
   * SVG content.  The SVG MUST use `fill="currentColor"` — it inherits the
   * Header's text colour and auto-adapts to light/dark mode, exactly like
   * the main Logo.astro.  Import with `?raw`:
   * ```astro
   * import logoRaw from '@/assets/…/logo.svg?raw';
   * ```
   *
   * **Legacy fallback:** Pass `secondaryLogo` as `ImageMetadata`.  Rendered
   * via `<img>` with a CSS filter for dark/light adaptation (cruder, kept
   * for backward compat).
   */
  secondaryLogo?: ImageMetadata;
  /** Raw SVG string for inline rendering (Chameleon pattern — preferred). */
  secondaryLogoSvg?: string;
  /** Optional link for the secondary logo. Defaults to no link (plain image). */
  secondaryLogoHref?: string;
  showLanguageSwitcher?: boolean;
  /** Optional map of `locale -> URL` for "same page, other language" links. Passed to LanguageSwitcher. */
  languageAlternates?: Record<string, string>;
  showSocialLinks?: boolean;
  showScrollProgress?: boolean;
  scrollProgressPosition?: 'top' | 'bottom';
  autoHide?: boolean;
  invertOnReturn?: boolean;
  /**
   * Max width of the inner container (only applies when `shape='bar'`).
   * Defaults to `'6xl'` (the historical width).
   */
  // FireStone: [Add '8xl' and '9xl' to the props interface]
  maxWidth?: '4xl' | '5xl' | '6xl' | '7xl' | '8xl' | '9xl' | 'full';
}

const {
  layout = 'default',
  position = 'fixed',
  size = '2xl',
  variant = 'progressive',
  colorScheme = 'invert',
  shape = 'bar',
  nav,
  extraNav = [],
  showCta = false,
  cta = { label: t('header.exploreProjects', locale), href: localizedPath('/projects', locale), icon: undefined, trailingIcon: undefined },
  actions = [],
  showSearch = true,
  showThemeToggle = true,
  showThemeSelector = false,
  showMobileMenu = true,
  showSocialLinks = true,
  showLanguageSwitcher = false,
  languageAlternates,
  showActiveState = true,
  showScrollProgress = false,
  scrollProgressPosition = 'bottom',
  autoHide = true,
  invertOnReturn = true,
  hideLogo = false,
  secondaryLogo,
  secondaryLogoSvg,
  secondaryLogoHref,
  maxWidth = '8xl',// FireStone: Change max width to full to adapt out designs.
  class: className,
  ...attrs
} = Astro.props;

// Strip width/height from raw SVG so CSS controls sizing, and inject Tailwind
// sizing + glow classes onto the <svg> element itself — exactly like Logo.astro.
// (CSS on a wrapper <span> doesn't constrain an inline SVG; the classes must be
// on the SVG root for height/width to work.)
const cleanSecondaryLogoSvg = secondaryLogoSvg
  ?.replace(/\s(width|height)="[^"]*"/g, '')
  .replace(/^<svg/, '<svg class="block h-6 w-auto shrink-0 hdr-logo-glow"');

const isFloating = shape === 'floating';
const maxWidthClass = {
  '4xl': 'max-w-4xl',
  '5xl': 'max-w-5xl',
  '6xl': 'max-w-6xl',
  '7xl': 'max-w-7xl',
  '8xl': 'max-w-8xl',
  '9xl': 'max-w-9xl',
  full: 'max-w-full',
}[maxWidth];
const effectiveShowScrollProgress = showScrollProgress || (isFloating && !autoHide);
const isInvert = colorScheme === 'invert';


const defaultNav = getNavItems(locale).map((item: ResolvedNavItem) => ({
  label: item.label,
  href: item.href,
}));
const navItems: NavItem[] = nav || [...extraNav, ...defaultNav];

const currentPath = Astro.url.pathname;
const isLandingPage = currentPath === '/';
const ctaHref = cta.href?.startsWith('#') && !isLandingPage ? `/${cta.href}` : cta.href;

const hasLogoSlot = Astro.slots.has('logo');
const hasNavSlot = Astro.slots.has('nav');
const hasActionsSlot = Astro.slots.has('actions');
const hasMobileMenuSlot = Astro.slots.has('mobile-menu');

// Dev-time guard: Header renders only its named slots (logo, nav, actions,
// mobile-menu) — it has no default <slot/>. So any default-slot content is
// silently dropped. The usual culprit is a misplaced </Header> that swallows
// the layout's page <slot /> and <Footer>, leaving the page blank below the
// navbar with no error. Warn loudly in dev so this fails fast instead of
// silently. No-op in production.
if (import.meta.env.DEV && Astro.slots.has('default')) {
  console.warn(
    '[Header] Received content in the default slot, which Header does not render — ' +
    'it only outputs the named slots (logo, nav, actions, mobile-menu), so this content is dropped. ' +
    'A common cause is a misplaced </Header> wrapping the page <slot /> or <Footer>: ' +
    'make sure those sit OUTSIDE <Header> and that only slotted children (e.g. <img slot="logo" />) sit inside it.'
  );
}

const headerClasses = cn(
  headerVariants({ position, variant, shape }),
  isInvert && !isFloating && 'invert-section',
  className
);

const innerClasses = cn(headerInnerVariants({ size, shape }), !isFloating && maxWidthClass);

function isActive(href: string): boolean {
  if (!showActiveState) return false;
  if (href.startsWith('#')) return false;
  return currentPath === href || currentPath.startsWith(href + '/');
}

function getSocialIconData(url: string): { icon: string; label: string } {
  return resolveSocialLinks([url], locale)[0];
}

function getNavIcon(href: string): string {
  if (href.startsWith('/')) href = stripLocaleFromPath(href);
  if (href === '/' || href === '') return 'home';
  if (href.startsWith('/blog'))     return 'pen-line';
  if (href.startsWith('/projects')) return 'layers';
  if (href.startsWith('/ai')) return 'sparkles';
  if (href.startsWith('/about'))    return 'user';
  if (href.startsWith('/contact'))  return 'mail';
  if (href.startsWith('#'))         return 'hash';
  if (href.startsWith('http'))      return 'arrow-up-right';
  return 'chevron-right';
}

const mobileSocialOrder = ['github.com', 'bilibili.com', 'zhihu.com', 'music.163.com', 'weibo.com', 'youtube.com', 'x.com'];
const mobileSocialLinks = mobileSocialOrder
  .map((host) => siteConfig.socialLinks.find((u) => u.includes(host)))
  .filter((u): u is string => Boolean(u));

const menuId = `mobile-menu-${Math.random().toString(36).slice(2, 9)}`;
const buttonId = `${menuId}-button`;
---

<header
  class={headerClasses}
  data-pagefind-ignore
  data-menu-id={menuId}
  data-button-id={buttonId}
  data-header-position={position}
  data-header-shape={shape}
  data-header-variant={variant}
  data-header-color-scheme={colorScheme}
  data-header-auto-hide={autoHide ? 'true' : 'false'}
  data-header-invert-on-return={invertOnReturn ? 'true' : 'false'}
  {...attrs}
>
  {variant === 'progressive' && (
    <div class="hdr-progressive-blur" aria-hidden="true">
      {[1, 2, 3, 4, 5].map((layer) => (
        <div class={`hdr-progressive-blur-layer hdr-progressive-blur-layer--${layer}`} />
      ))}
    </div>
  )}
  {(showSearch || (showMobileMenu && layout !== 'minimal')) && (
    <div class="hdr-menu-surface" aria-hidden="true" />
  )}
  <div class={cn(innerClasses, 'hdr-inner')}>
    {
      !hideLogo && (
        <div class="flex items-center justify-self-start">
          {/* FireStone: Use CSS Grid on mobile to stack logos for crossfade, and Flexbox on desktop to put them side-by-side */}
          <div class="mobile-logo-wrapper grid items-center lg:flex lg:flex-row">
            
            {/* Main Logo Container */}
            {/* FireStone: [Conditionally apply the crossfade animation ONLY if a secondary logo exists] */}
            <div class={cn(
              "col-start-1 row-start-1 flex items-center",
              (cleanSecondaryLogoSvg || secondaryLogo) && "animate-logo-main lg:!animate-none"
            )}>
              {hasLogoSlot ? (
                <slot name="logo" />
              ) : (
                <a href={localizedPath('/', locale)} class="flex items-center w-fit" aria-label={t('common.logo', locale)}>
                  <Logo
                    size={size === 'sm' ? 'md' : 'lg'}
                    class="text-foreground hdr-logo-glow"
                  />
                </a>
              )}
            </div>

            {/* Secondary logo — rendered to the right of the main site logo with a
              vertical divider.  Same glow + scale hover as the main logo.

              **Chameleon pattern (preferred):** Pass `secondaryLogoSvg` (raw SVG
              with `fill="currentColor"`).  The inline SVG inherits the Header's
              text colour and auto-adapts to light/dark mode — no filter needed.

              **Legacy fallback:** Pass `secondaryLogo` (ImageMetadata) for <img>
              rendering with a CSS filter. */}
            {(cleanSecondaryLogoSvg || secondaryLogo) && (
              <>
                {/* Divider (Hidden on mobile) */}
                <span
                  class="hidden lg:block mx-3.5 h-6 w-px bg-foreground-subtle/50 shrink-0"
                  aria-hidden="true"
                ></span>

                {/* Secondary Logo Container */}
                <div class="col-start-1 row-start-1 flex items-center opacity-0 pointer-events-none lg:opacity-100 lg:pointer-events-auto animate-logo-secondary lg:!animate-none">
                  {secondaryLogoHref ? (
                    <a
                      href={secondaryLogoHref}
                      class="flex items-center shrink-0"
                      aria-label={secondaryLogoHref.replace(/^\//, '')}
                    >
                      {cleanSecondaryLogoSvg ? (
                        <span
                          class="inline-block text-foreground shrink-0"
                          set:html={cleanSecondaryLogoSvg}
                        />
                      ) : secondaryLogo ? (
                        <img
                          src={secondaryLogo.src}
                          alt=""
                          width={secondaryLogo.width}
                          height={secondaryLogo.height}
                          class="hdr-secondary-logo h-8 w-auto object-contain hdr-logo-glow"
                          decoding="async"
                        />
                      ) : null}
                    </a>
                  ) : (
                    cleanSecondaryLogoSvg ? (
                      <span
                        class="inline-block text-foreground shrink-0"
                        set:html={cleanSecondaryLogoSvg}
                      />
                    ) : secondaryLogo ? (
                      <img
                        src={secondaryLogo.src}
                        alt=""
                        width={secondaryLogo.width}
                        height={secondaryLogo.height}
                        class="hdr-secondary-logo h-8 w-auto object-contain hdr-logo-glow shrink-0"
                        decoding="async"
                      />
                    ) : null
                  )}
                </div>
              </>
            )}
          </div>
        </div>
      )
    }

    {
      layout !== 'minimal' &&
        (hasNavSlot ? (
          <nav class="hidden items-center gap-1 lg:flex" aria-label={t('nav.mainNav', locale)}>
            <slot name="nav" />
          </nav>
        ) : (
          <nav class="hidden items-center gap-1 lg:flex" aria-label={t('nav.mainNav', locale)}>
            {navItems.map(({ label, href }) => (
              <a
                href={href.startsWith('#') && !isLandingPage ? `/${href}` : href}
                class={cn(
                  'relative rounded-full px-3 py-2 text-sm',
                  'hover-glow-text weight-shift',
                  isFloating && 'hdr-invert-text',
                  isFloating
                    ? (isActive(href) ? 'text-foreground text-shadow-[0_0_10px_currentColor] font-bold' : 'text-foreground-secondary font-medium')
                    : (isActive(href) 
                        ? 'text-foreground text-shadow-[0_0_10px_currentColor] font-bold' 
                        : 'text-foreground-secondary hover:text-foreground focus-visible:text-foreground font-medium')
                )}
                aria-current={isActive(href) ? 'page' : undefined}
                data-text={label}
              >
                {label}
              </a>
            ))}
          </nav>
        ))
    }

    <div class="flex items-center gap-2 justify-self-end">
      {
        hasActionsSlot ? (
          <slot name="actions" />
        ) : (
          <>
            {showSearch && (
              <div class="flex">
                <SearchModal class={isFloating ? 'hdr-invert-text' : undefined} />
              </div>
            )}

            {showThemeToggle && (
              <div class="flex">
                <ThemeModeDropdown class={isFloating ? 'hdr-invert-text' : undefined} />
              </div>
            )}

            {showThemeSelector && (
              <div class="hidden lg:flex">
                <ThemeSelectorDropdown class={isFloating ? 'hdr-invert-text' : undefined} />
              </div>
            )}

            {showLanguageSwitcher && (
              <div class="hidden lg:flex">
                <LanguageSwitcher class={isFloating ? 'hdr-invert-text' : undefined} alternates={languageAlternates} />
              </div>
            )}

            {showSocialLinks && siteConfig.socialLinks.length > 0 && (
              <div class="hidden lg:flex items-center gap-0.5">
                {siteConfig.socialLinks.map((url) => {
                  const { icon, label } = getSocialIconData(url);
                  return (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={label}
                      class={cn(
                        'rounded-full p-2',
                        'hover-glow-icon',
                        'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
                        isFloating
                          ? 'hdr-invert-text'
                          : 'text-foreground-secondary hover:text-foreground focus-visible:text-foreground'
                      )}
                    >
                      <Icon name={icon} size="md" />
                    </a>
                  );
                })}
              </div>
            )}

            {actions.map((action) => (
              <Button
                variant="ghost"
                size="sm"
                icon={action.iconOnly}
                href={action.href}
                target={action.target}
                aria-label={action.label}
                class={isFloating ? 'hdr-invert-text' : undefined}
              >
                <Icon name={action.icon} size="sm" />
                {!action.iconOnly && action.label}
              </Button>
            ))}

            {showCta && (
              <div class="hidden lg:flex">
                <Button
                  size="sm"
                  href={ctaHref}
                  target={ctaHref?.startsWith('http') ? '_blank' : undefined}
                  class={cn('hdr-cta-brand', isFloating ? 'hdr-invert-cta' : undefined)}
                >
                  {cta.icon && <Icon name={cta.icon} size="sm" />}
                  {cta.label}
                  {cta.trailingIcon && <Icon name={cta.trailingIcon} size="sm" />}
                </Button>
              </div>
            )}
          </>
        )
      }

      {
        showMobileMenu && layout !== 'minimal' && (
          <button
            type="button"
            id={buttonId}
            class={cn(
              'hdr-hamburger inline-flex items-center justify-center rounded-md p-2 lg:hidden',
              'hover-glow-icon', /* FireStone: Hamburger 菜单应用统一交互引擎 */
              'focus-visible:ring-ring focus-visible:ring-2 focus-visible:outline-none',
              isFloating ? 'hover:bg-secondary/40' : 'hover:bg-secondary'
            )}
            aria-expanded="false"
            aria-controls={menuId}
            aria-label={t('nav.toggleMenu', locale)}
          >
            <span class="menu-icon">
              <Icon name="menu" size="md" />
            </span>
            <span class="close-icon hidden">
              <Icon name="x" size="md" />
            </span>
          </button>
        )
      }
    </div>
  </div>

  {effectiveShowScrollProgress && (
    isFloating ? (
      <div
        class={`absolute inset-x-3 h-0.5 overflow-hidden rounded-full ${scrollProgressPosition === 'top' ? 'top-0.5' : 'bottom-0.5'}`}
        aria-hidden="true"
      >
        <div
          id="scroll-progress-bar"
          class="absolute left-0 top-0 h-full w-0 bg-brand-500 transition-none"
        />
      </div>
    ) : (
      <div
        id="scroll-progress-bar"
        class={`absolute left-0 h-0.5 w-0 bg-brand-500 transition-none ${scrollProgressPosition === 'top' ? 'top-0' : 'bottom-0'}`}
        aria-hidden="true"
      />
    )
  )}

  {
    showMobileMenu &&
      layout !== 'minimal' &&
      (hasMobileMenuSlot ? (
        <div
          id={menuId}
          class={cn(
            'mobile-menu-panel', // FireStone: Target class for theme protection
            'hidden absolute inset-x-0 top-full shadow-[0_8px_24px_-12px_rgba(0,0,0,0.12)] lg:hidden',
            isFloating
              ? 'rounded-b-2xl bg-background/95 backdrop-blur-xl'
              : 'border-border bg-background border-t'
          )}
          role="navigation"
          inert
          aria-label={t('nav.mobileNav', locale)}
        >
          <slot name="mobile-menu" />
        </div>
      ) : (
        <div
          id={menuId}
          class={cn(
            'mobile-menu-panel', // FireStone: Target class for theme protection
            'hidden absolute inset-x-0 top-full shadow-[0_8px_24px_-12px_rgba(0,0,0,0.12)] lg:hidden',
            isFloating
              ? 'rounded-b-2xl bg-background/95 backdrop-blur-xl'
              : 'border-border bg-background border-t'
          )}
          role="navigation"
          inert
          aria-label={t('nav.mobileNav', locale)}
        >
          <div class={cn(
            'mobile-menu-body py-3',
            isFloating ? 'px-3' : cn('mx-auto px-4', maxWidthClass)
          )}>
            <section class="mobile-menu-section">
              <p class="mobile-menu-label">{t('nav.sectionNavigate', locale)}</p>
              <ul class="space-y-0.5">
                {navItems.map(({ label, href }, idx) => {
                  const active = isActive(href);
                  const resolvedHref = href.startsWith('#') && !isLandingPage ? `/${href}` : href;
                  return (
                    <li>
                      <a
                        href={resolvedHref}
                        class={cn(
                          'mobile-menu-row mobile-menu-stagger group flex items-center gap-3 rounded-xl px-3 py-3 text-base transition-colors',
                          active
                            ? 'mobile-menu-row-active'
                            : 'mobile-menu-row-inactive'
                        )}
                        style={`--stagger-index: ${idx}`}
                        aria-current={active ? 'page' : undefined}
                      >
                        <span class="mobile-menu-tile">
                          <Icon name={getNavIcon(href)} size="sm" />
                        </span>
                        <span class="flex-1">{label}</span>
                        <Icon name="chevron-right" size="sm" class="mobile-menu-chevron" />
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>

            {showThemeSelector && (
              <section class="mobile-menu-section">
                <p class="mobile-menu-label">{t('nav.sectionTheme', locale)}</p>
                <div
                  class="mobile-menu-stagger flex items-center justify-between rounded-xl px-3 py-2.5"
                  style={`--stagger-index: ${navItems.length}`}
                >
                  <span class="text-sm text-foreground-muted">{t('theme.colourTheme', locale)}</span>
                  <ThemeSelector />
                </div>
              </section>
            )}

            {showLanguageSwitcher && (
              <section class="mobile-menu-section">
                <p class="mobile-menu-label">{t('nav.sectionLanguage', locale)}</p>
                <div
                  class="mobile-menu-stagger flex items-center justify-between rounded-xl px-3 py-2.5"
                  style={`--stagger-index: ${navItems.length + (showThemeSelector ? 1 : 0)}`}
                >
                  <span class="text-sm text-foreground-muted">{t('nav.sectionLanguage', locale)}</span>
                  <LanguageSwitcher alternates={languageAlternates} />
                </div>
              </section>
            )}

            {mobileSocialLinks.length > 0 && (
              <section class="mobile-menu-section">
                <p class="mobile-menu-label">{t('footer.socialMedia', locale)}</p>
                <div class="flex flex-wrap items-center gap-2 px-2 pt-1 pb-2">
                  {mobileSocialLinks.map((url, sIdx) => {
                    const { icon, label } = getSocialIconData(url);
                    return (
                      <span
                        class="mobile-menu-stagger mobile-menu-social inline-flex"
                        style={`--stagger-index: ${navItems.length + (showThemeSelector ? 1 : 0) + (showLanguageSwitcher ? 1 : 0) + sIdx}`}
                      >
                        <a
                          href={url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={label}
                          title={label}
                          class="glass-panel hover-glow-box hover-solid-fill inline-flex h-11 w-11 items-center justify-center rounded-full border border-border-strong text-foreground-muted transition-colors"
                        >
                          <Icon name={icon} size="md" />
                        </a>
                      </span>
                    );
                  })}
                </div>
              </section>
            )}

            {showCta && (
              <div
                class="mobile-menu-stagger mobile-menu-cta-wrap pt-2"
                style={`--stagger-index: ${navItems.length + (showThemeSelector ? 1 : 0) + (showLanguageSwitcher ? 1 : 0) + mobileSocialLinks.length}`}
              >
                <Button fullWidth href={ctaHref} target={ctaHref?.startsWith('http') ? '_blank' : undefined}>
                  {cta.icon && <Icon name={cta.icon} size="sm" />}
                  {cta.label}
                  {cta.trailingIcon && <Icon name={cta.trailingIcon} size="sm" />}
                </Button>
              </div>
            )}
          </div>
        </div>
      ))
  }
</header>

{
  showMobileMenu && layout !== 'minimal' && (
    <div
      id={`${menuId}-backdrop`}
      class="mobile-menu-backdrop pointer-events-none fixed inset-0 z-40 bg-background/40 backdrop-blur-md lg:hidden"
      aria-hidden="true"
    />
  )
}

<script>
  import { animateHeaderSurface, headerMotionTiming } from '@/lib/headerMotion';

  function initMobileMenu() {
    const menuHeaders = document.querySelectorAll<HTMLElement>('header[data-menu-id]');
    menuHeaders.forEach((header) => {
      const menuId = header.dataset.menuId!;
      const buttonId = header.dataset.buttonId!;
      const isFloating = header.dataset.headerShape === 'floating';

      const button = document.getElementById(buttonId);
      const menu = document.getElementById(menuId);
      const backdrop = document.getElementById(`${menuId}-backdrop`);
      const menuIcon = button?.querySelector('.menu-icon');
      const closeIcon = button?.querySelector('.close-icon');

      if (!button || !menu || !menuIcon || !closeIcon) return;
      if (button.dataset.menuInit) return;
      button.dataset.menuInit = 'true';

      let isOpen = false;
      let menuAnimation: Animation | undefined;
      let socialExits: Animation[] = [];

      function fitMenu() {
        const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
        menu!.style.setProperty('--mobile-menu-height', `${Math.max(0, viewportHeight - header.getBoundingClientRect().bottom - 12)}px`);
      }

      function animateMenu(opening: boolean) {
        const wasHidden = menu!.classList.contains('hidden');
        const style = getComputedStyle(menu!);
        const from = wasHidden
          ? { opacity: '0', clipPath: 'inset(0 0 100% 0)' }
          : { opacity: style.opacity, clipPath: style.clipPath === 'none' ? 'inset(0 0 0% 0)' : style.clipPath };
        menuAnimation?.cancel();
        menu!.classList.remove('hidden');
        animateHeaderSurface(header, 'data-menu-expanded', opening);
        const timing = headerMotionTiming();
        // Reveal the panel without scaling its text or changing the page layout.
        menuAnimation = menu!.animate([
          from,
          opening ? { opacity: '1', clipPath: 'inset(0 0 0% 0)' } : { opacity: '0', clipPath: 'inset(0 0 100% 0)' },
        ], timing);
        return menuAnimation.finished;
      }

      function open() {
        if (isOpen) return;
        header.dispatchEvent(new Event('header:menu-open'));
        isOpen = true;
        socialExits.forEach((animation) => animation.cancel());
        socialExits = [];

        button!.setAttribute('aria-expanded', 'true');
        menuIcon!.classList.add('hidden');
        closeIcon!.classList.remove('hidden');

        // FireStone: [Explicitly set state attribute on header when menu opens to bypass CSS :has() compiler bugs]
        header.setAttribute('data-menu-open', 'true');

        if (isFloating) {
          header.classList.remove('rounded-2xl');
          header.classList.add('rounded-t-2xl');
        }

        fitMenu();
        menu!.inert = false;
        menu!.dataset.menuState = 'open';
        void animateMenu(true).then(() => {
          if (isOpen) {
            menuAnimation?.cancel();
          }
        }, () => {});
        // A reversed close keeps the same DOM/CSS state; restart each stagger explicitly.
        menu!.getAnimations({ subtree: true }).forEach(animation => {
          if (animation instanceof CSSAnimation && animation.animationName === 'mobileMenuItemIn') {
            animation.currentTime = 0;
            animation.play();
          }
        });
        if (backdrop) {
          backdrop.classList.remove('pointer-events-none');
          backdrop.setAttribute('data-open', '');
        }
      }

      function close() {
        if (!isOpen) return;
        isOpen = false;

        button!.setAttribute('aria-expanded', 'false');
        menuIcon!.classList.remove('hidden');
        closeIcon!.classList.add('hidden');

        if (menu!.contains(document.activeElement)) button!.focus();
        menu!.inert = true;
        backdrop?.removeAttribute('data-open');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          socialExits = [...menu!.querySelectorAll<HTMLElement>('.mobile-menu-social')].reverse().map((item, index) => {
            const style = getComputedStyle(item);
            return item.animate([
              { opacity: style.opacity, transform: style.transform },
              { opacity: 0, transform: 'translateY(6px)' },
            ], { duration: 600, delay: index * 75, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' });
          });
        }
        void Promise.all([animateMenu(false), ...socialExits.map((animation) => animation.finished)]).then(() => {
          if (isOpen) return;
          menu!.classList.add('hidden');
          delete menu!.dataset.menuState;
          menuAnimation?.cancel();
          socialExits.forEach((animation) => animation.cancel());
          socialExits = [];
          header.removeAttribute('data-menu-open');
          if (backdrop) {
            backdrop.classList.add('pointer-events-none');
          }

          if (isFloating) {
            header.classList.remove('rounded-t-2xl');
            header.classList.add('rounded-2xl');
            if (window.scrollY <= 60) {
              header.removeAttribute('data-scrolled');
            }
          }

        }, () => {});
      }

      function toggle() {
        if (isOpen) {
          close();
        } else {
          open();
        }
      }

      button.addEventListener('click', toggle);
      header.addEventListener('header:search-open', close);
      window.addEventListener('resize', () => {
        if (!isOpen) return;
        if (matchMedia('(min-width: 1024px)').matches) close();
        else fitMenu();
      });
      window.visualViewport?.addEventListener('resize', () => { if (isOpen) fitMenu(); });

      if (backdrop) {
        backdrop.addEventListener('click', close);
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen) {
          close();
        }
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', close);
      });
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>

<script>
  // Header scroll behaviour + scroll-progress bar driven by a single rAF.
  // All layout reads are taken before any DOM writes. `docMaxScrollY` is
  // cached; the first read is deferred to a rAF so it runs AFTER first
  // paint instead of forcing a synchronous layout before it. ResizeObserver
  // handles subsequent changes (font swap, image loads, reveal animations)
  // without re-introducing a critical-path reflow.
  const SCROLL_THRESHOLD = 60;
  const AUTO_HIDE_THRESHOLD = 150;
  const BAR_SCROLLED_CLASSES = ['bg-background/80', 'backdrop-blur-lg', 'border-b', 'border-border/50'];

  let docMaxScrollY = 0;
  let docMetricsInited = false;
  function updateDocMaxScrollY() {
    docMaxScrollY = document.documentElement.scrollHeight - window.innerHeight;
  }
  function initDocMetrics() {
    if (docMetricsInited) return;
    docMetricsInited = true;
    window.addEventListener('resize', updateDocMaxScrollY, { passive: true });
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(updateDocMaxScrollY).observe(document.documentElement);
    }
  }

  function initScrollDriven() {
    initDocMetrics();

    const scrollHeaders = document.querySelectorAll<HTMLElement>(
      'header[data-header-shape="floating"], header[data-header-shape="bar"]'
    );
    const progressBar = document.getElementById('scroll-progress-bar');

    scrollHeaders.forEach((header) => {
      if (header.dataset.scrollInit) return;
      header.dataset.scrollInit = 'true';

      const isBar = header.dataset.headerShape === 'bar';
      const isFloating = header.dataset.headerShape === 'floating';
      const isAutoHide = header.dataset.headerAutoHide !== 'false';
      const isTransparentBar = isBar && header.dataset.headerVariant === 'transparent';
      let ticking = false;
      let lastScrollY = window.scrollY;
      let lastShownAtY = 0;

      function onScroll() {
        if (ticking) return;
        ticking = true;

        requestAnimationFrame(() => {
          // ── READS (gather everything before touching the DOM) ──
          const currentScrollY = window.scrollY;
          const menuId = header.dataset.menuId;
          const menu = menuId ? document.getElementById(menuId) : null;
          const menuOpen = header.hasAttribute('data-search-active') || (menu && !menu.classList.contains('hidden'));
          const wasHidden = header.hasAttribute('data-header-hidden');

          // ── WRITES ──
          if (currentScrollY > SCROLL_THRESHOLD) {
            header.setAttribute('data-scrolled', '');
            if (isTransparentBar) {
              header.classList.add(...BAR_SCROLLED_CLASSES);
              header.classList.remove('bg-transparent');
            }
          } else {
            if (!menuOpen) {
              header.removeAttribute('data-scrolled');
              header.removeAttribute('data-header-hidden');
              lastShownAtY = 0;
              if (isTransparentBar) {
                header.classList.remove(...BAR_SCROLLED_CLASSES);
                header.classList.add('bg-transparent');
              }
            }
          }

          if (isFloating && isAutoHide && !menuOpen) {
            if (currentScrollY > AUTO_HIDE_THRESHOLD) {
              if (currentScrollY > lastScrollY) {
                if (currentScrollY - lastShownAtY >= AUTO_HIDE_THRESHOLD) {
                  header.setAttribute('data-header-hidden', '');
                }
              } else {
                if (wasHidden) {
                  lastShownAtY = Math.min(
                    currentScrollY,
                    Math.max(0, docMaxScrollY - AUTO_HIDE_THRESHOLD),
                  );
                  header.setAttribute('data-header-returned', '');
                }
                header.removeAttribute('data-header-hidden');
              }
            } else {
              header.removeAttribute('data-header-hidden');
              header.removeAttribute('data-header-returned');
              lastShownAtY = 0;
            }
          }

          // Drive the scroll-progress bar in the same frame, using the
          // already-read currentScrollY and the cached docMaxScrollY.
          if (progressBar) {
            const pct = docMaxScrollY > 0 ? (currentScrollY / docMaxScrollY) * 100 : 0;
            progressBar.style.width = `${pct}%`;
          }

          lastScrollY = currentScrollY;
          ticking = false;
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      // Defer the first read+write to the next frame so layout reads
      // happen AFTER the browser has committed initial paint.
      requestAnimationFrame(() => {
        updateDocMaxScrollY();
        onScroll();
      });
    });

    // Edge case: a progress bar exists without a header scroll-watcher.
    // Drive it with its own minimal rAF so the bar still updates.
    if (progressBar && scrollHeaders.length === 0 && !progressBar.dataset.progressInit) {
      progressBar.dataset.progressInit = 'true';
      let pTicking = false;
      const updateProgress = () => {
        const pct = docMaxScrollY > 0 ? (window.scrollY / docMaxScrollY) * 100 : 0;
        progressBar.style.width = `${pct}%`;
        pTicking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!pTicking) {
            pTicking = true;
            requestAnimationFrame(updateProgress);
          }
        },
        { passive: true },
      );
      requestAnimationFrame(() => {
        updateDocMaxScrollY();
        updateProgress();
      });
    }
  }

  initScrollDriven();
  document.addEventListener('astro:page-load', initScrollDriven);
  document.addEventListener('astro:after-swap', initScrollDriven);
</script>

<style is:global>

/* =========================================================================
    FireStone: Progressive Background Blur (渐进式毛玻璃)
    ========================================================================= */
/* Keep the original glass stable beneath the independently animated menu surface. */
header.hdr-progressive-glass {
  background-color: transparent !important;
  border: none !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
  box-shadow: none !important;
}

/* One solid surface fades over the existing transparent/glass header. */
.hdr-menu-surface {
  position: absolute;
  inset: 0;
  z-index: 0;
  border-radius: inherit;
  pointer-events: none;
  background: var(--background);
  opacity: 0;
}
header:is([data-menu-expanded], [data-search-expanded]) > .hdr-menu-surface { opacity: 1; }
header[data-search-active] { z-index: 101; }
/* A body scroll lock can move a sticky header out of its scroll container.
   Keep it attached to the viewport while its search dialog is open so the
   dialog backdrop never replaces the header during a scroll. */
header[data-search-active][data-header-position='sticky'] {
  position: fixed;
  inset-inline: 0;
}
header[data-search-active] > .hdr-inner { pointer-events: auto; }
header > .hdr-inner { position: relative; z-index: 1; }
header > .mobile-menu-panel { z-index: 2; }

.hdr-progressive-blur {
  position: absolute;
  inset: 0 0 auto;
  height: 100%;
  z-index: -1;
  pointer-events: none;
  border-radius: inherit;
}

/* Menu contrast changes must not recolour the glass being revealed underneath. */
header.invert-section > .hdr-progressive-blur {
  --color-background: var(--surface-invert);
}

/* Keep opacity and masks on individual layers: a faded wrapper would become
   a backdrop root and prevent its children from sampling the page behind it. */
.hdr-progressive-blur-layer,
.hdr-progressive-blur::after {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 400ms var(--ease-fluid), visibility 400ms;
}

.hdr-progressive-blur::after {
  content: '';
  border-radius: inherit;
  /* Fade the tint directly so a filter cannot soften the viewport edges or
     extend the color beyond the header's height. */
  background: linear-gradient(
    to bottom in oklab,
    color-mix(in oklab, var(--color-background) 65%, transparent) 0%,
    color-mix(in oklab, var(--color-background) 62%, transparent) 12%,
    color-mix(in oklab, var(--color-background) 56%, transparent) 25%,
    color-mix(in oklab, var(--color-background) 45%, transparent) 40%,
    color-mix(in oklab, var(--color-background) 32%, transparent) 55%,
    color-mix(in oklab, var(--color-background) 20%, transparent) 70%,
    color-mix(in oklab, var(--color-background) 7%, transparent) 85%,
    transparent 100%
  );
}

.hdr-progressive-blur-layer {
  -webkit-backdrop-filter: blur(var(--hdr-blur));
  backdrop-filter: blur(var(--hdr-blur));
  -webkit-mask-image: var(--hdr-blur-mask);
  mask-image: var(--hdr-blur-mask);
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
}

/* Overlapping bands reproduce the reference's strong-to-soft blur profile. */
.hdr-progressive-blur-layer--1 {
  --hdr-blur: 4px;
  --hdr-blur-mask: linear-gradient(to bottom, transparent 40%, black 60% 80%, transparent 100%);
}

.hdr-progressive-blur-layer--2 {
  --hdr-blur: 6px;
  --hdr-blur-mask: linear-gradient(to bottom, transparent 20%, black 40% 60%, transparent 80%);
}

.hdr-progressive-blur-layer--3 {
  --hdr-blur: 10px;
  --hdr-blur-mask: linear-gradient(to bottom, transparent 0%, black 20% 40%, transparent 60%);
}

.hdr-progressive-blur-layer--4 {
  --hdr-blur: 18px;
  --hdr-blur-mask: linear-gradient(to bottom, black 0% 20%, transparent 40%);
}

.hdr-progressive-blur-layer--5 {
  --hdr-blur: 34px;
  --hdr-blur-mask: linear-gradient(to bottom, black 0%, transparent 20%);
}

/* 当页面发生滚动时，渐进式模糊平滑显现 */
header[data-scrolled]:not([data-header-hidden]) > .hdr-progressive-blur > .hdr-progressive-blur-layer,
header[data-scrolled]:not([data-header-hidden]) > .hdr-progressive-blur::after {
  opacity: 1;
  visibility: visible;
}

@media (prefers-reduced-motion: reduce) {
  .hdr-progressive-blur-layer,
  .hdr-progressive-blur::after {
    transition: none;
  }
}

.mobile-menu-panel {
  max-height: var(--mobile-menu-height, calc(100svh - 6rem));
  overflow-y: auto;
  overscroll-behavior: contain;
}

.mobile-menu-backdrop {
  opacity: 0;
  transition: opacity 800ms var(--ease-default);
  touch-action: none;
}

.mobile-menu-backdrop[data-open] {
  opacity: 1;
}

@media (prefers-reduced-motion: reduce) {
  .mobile-menu-backdrop { transition: none; }
}

