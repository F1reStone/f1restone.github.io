---
/**
 * Horizontal list of tag chips that link to permalink tag archive pages
 * (`/blog/tag/<slug>`). Pure HTML — no JS.
 *
 * FireStone: Uses Badge component with brand variant, dot separators,
 * and glow effects. i18n-aware via `getTagUrl` from upstream.
 */
import { getTagUrl } from '@/lib/blog';
import { defaultLocale } from '@/i18n';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';

interface Props {
  tags: string[];
  /** Highlight this tag (used on the tag archive page). */
  active?: string;
  /**
   * Locale the links belong to. Default-locale links stay at `/blog/tag/...`;
   * other locales are prefixed (`/<locale>/blog/tag/...`).
   */
  locale?: string;
  /** Optional class extension. */
  class?: string;
}

const { tags, active, locale = defaultLocale, class: extraClass } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={['flex flex-wrap items-center gap-1.5', extraClass]} aria-label="Browse by tag">
    {tags.map((tag, index) => {
      const isActive = active === tag;
      return (
        <>
          {index > 0 && <li class="h-0.5 w-0.5 rounded-full bg-foreground-subtle/50 shrink-0" aria-hidden="true" />}
          <li>
            <Badge
              href={getTagUrl(tag, locale)}
              variant={isActive ? 'default' : 'brand'}
              aria-current={isActive ? 'page' : undefined}
              class={isActive ? 'drop-shadow-[0_0_12px_currentColor] text-foreground' : ''}
            >
              #{tag}
            </Badge>
          </li>
        </>
      );
    })}
  </ul>
)}
