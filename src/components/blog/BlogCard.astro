---
/**
 * Blog listing card.
 * FireStone Refactored: Interactive Glass Reveal Card, aligned with ProjectCard.
 *
 * - Full-bleed cover with the title always visible.
 * - On hover/focus a progressive blur layer and an expanding CSS Grid reveal
 *   the date, reading time, and monochrome tags without shifting the grid.
 * - The whole card is one link; the arrow is a decorative jump affordance.
 * - Scroll reveals are delegated to the parent `data-reveal` contract.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate, getReadingTime } from '@/lib/utils';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogImageSVG from '@/components/blog/BlogImageSVG.astro';
import { t, type Locale } from '@/i18n';

interface Props {
  title: string;
  description: string;
  href: string;
  publishedAt: Date;
  tags?: string[];
  featured?: boolean;
  author?: string;
  image?: ImageMetadata;
  svgSlug?: string;
  /** Raw post body, used to estimate reading time (CJK-aware). */
  body: string | undefined;
  /** Active locale for i18n labels. */
  locale?: Locale;
  /**
   * Marks the first card on a listing page. On mobile it reveals on load with
   * the standard animation instead of waiting for scroll.
   */
  eager?: boolean;
  /**
   * Stagger index for the scroll-reveal cascade. Maps to `data-reveal-delay`
   * (1–4 → 100–400ms) so a grid of cards rises one after another.
   */
  revealDelay?: number;
  class?: string;
}

const {
  title,
  description,
  href,
  publishedAt,
  tags = [],
  author: _author,
  image,
  svgSlug,
  body,
  locale = 'zh-CN',
  eager = false,
  revealDelay,
  class: className,
} = Astro.props;

// Reading time from the actual post body (falls back to the description if no
// body is passed). Counts CJK characters, so space-less languages such as
// Chinese and Japanese are estimated accurately.
const readingTime = getReadingTime(body ?? description);
---

<article
  class:list={['w-full h-full', className]}
  data-reveal
  data-reveal-delay={revealDelay || undefined}
  data-reveal-eager={eager ? '' : undefined}
>
  <Card
    variant="default"
    padding="none"
    href={href}
    class="group relative overflow-hidden aspect-[4/3] sm:aspect-[16/10] bg-background-tertiary border-border/50 hover-glow-box block w-full h-full"
  >
    {/* 1. Cover: image, generated SVG art, or a quiet brand fallback. */}
    <div class="absolute inset-0 overflow-hidden">
      {svgSlug ? (
        <div class="blog-card-svg h-full w-full transition-transform duration-700 ease-[var(--ease-fluid)] group-hover:scale-105">
          <BlogImageSVG slug={svgSlug} title={title} />
        </div>
      ) : image ? (
        <Picture
          src={image}
          alt={title}
          widths={[320, 640, 960]}
          sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 400px"
          formats={['avif', 'webp']}
          class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-fluid)] group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="h-full w-full bg-gradient-to-br from-brand-500/20 to-brand-500/5 transition-transform duration-700 ease-[var(--ease-fluid)] group-hover:scale-105" />
      )}
    </div>

    {/* 2. Base readability wash: always present, so the title never depends on the cover. */}
    <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/20 to-transparent pointer-events-none" />

    {/* 3. Progressive blur on hover: split from the gradient to avoid WebKit blur animation glitches. */}
    <div class="blog-card-blur absolute -inset-4 pointer-events-none" />
    <div class="blog-card-gradient absolute -inset-4 opacity-0 translate-y-6 transition-all duration-500 ease-[var(--ease-fluid)] group-hover:opacity-100 group-focus-visible:opacity-100 group-active:opacity-100 group-hover:translate-y-0 group-focus-visible:translate-y-0 group-active:translate-y-0 pointer-events-none" />

    {/* 4. Decorative jump affordance, matching the project card. */}
    <span class="blog-card-arrow absolute top-3 right-3 sm:top-4 sm:right-4 flex items-center justify-center w-8 h-8 rounded-full glass-panel hover-glow-box hover-solid-fill text-white shadow-lg z-20">
      <Icon name="arrow-up-right" size="sm" class="w-4 h-4" />
    </span>

    {/* 5. Bottom-anchored content: title stays, details expand beneath it. */}
    <div class="absolute inset-0 flex flex-col justify-end p-5 sm:p-6 z-10 pointer-events-none">
      <div class="flex flex-col">
        <h3 class="blog-card-title font-display text-xl sm:text-2xl font-bold text-foreground drop-shadow-md tracking-tight leading-tight line-clamp-2">
          {title}
        </h3>

        <div class="blog-card-details">
          <div class="overflow-hidden">
            <div class="blog-card-details-inner pt-3 flex flex-col gap-2.5">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-foreground-muted">
                <time datetime={publishedAt.toISOString()} class="flex items-center gap-1.5">
                  <Icon name="calendar" size="xs" />
                  {formatDate(publishedAt, locale)}
                </time>

                <span class="flex items-center gap-1.5">
                  <Icon name="clock" size="xs" />
                  {t('blog.readingTime', locale, { minutes: readingTime })}
                </span>
              </div>

              {tags.length > 0 && (
                <div class="flex flex-wrap items-center gap-1.5">
                  {tags.map((tag, index) => (
                    <>
                      {index > 0 && (
                        <span
                          class="h-0.5 w-0.5 rounded-full bg-foreground-muted/50 shrink-0"
                          aria-hidden="true"
                        />
                      )}
                      <Badge variant="default" size="sm" class="sm:text-xs">
                        #{tag}
                      </Badge>
                    </>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </Card>
</article>

<style>
  /* =========================================================================
     FireStone: Blog Card Interactive Overlay & Animation Engine
     ========================================================================= */

  /* 1. Pure blur layer (no opacity animation, avoiding WebKit/Blink blur bugs). */
  .blog-card-blur {
    backdrop-filter: blur(0px);
    transition:
      backdrop-filter 500ms var(--ease-fluid),
      -webkit-backdrop-filter 500ms var(--ease-fluid);
    mask-image: linear-gradient(to top, black 0%, black 45%, transparent 90%);
  }

  .group:hover .blog-card-blur,
  .group:focus-visible .blog-card-blur,
  .group:active .blog-card-blur {
    backdrop-filter: blur(14px);
  }

  /* FireStone: keep the legacy fallback in @supports so Lightning CSS does not
     collapse the standard property out of the production bundle. */
  @supports (-webkit-backdrop-filter: blur(0px)) {
    .blog-card-blur {
      -webkit-backdrop-filter: blur(0px);
    }

    .group:hover .blog-card-blur,
    .group:focus-visible .blog-card-blur,
    .group:active .blog-card-blur {
      -webkit-backdrop-filter: blur(14px);
    }
  }

  /* 2. Strengthened gradient: grows upward from the bottom on hover. */
  .blog-card-gradient {
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--color-background) 95%, transparent) 0%,
      color-mix(in oklch, var(--color-background) 65%, transparent) 50%,
      transparent 100%
    );
    mask-image: linear-gradient(to top, black 0%, black 45%, transparent 90%);
  }

  /* 3. Dynamic height reveal: 0fr → 1fr keeps the grid layout stable. */
  .blog-card-details {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 400ms var(--ease-fluid) 100ms;
  }

  .group:hover .blog-card-details,
  .group:focus-visible .blog-card-details,
  .group:active .blog-card-details {
    grid-template-rows: 1fr;
    transition: grid-template-rows 500ms var(--ease-fluid) 0ms;
  }

  .blog-card-details-inner {
    min-height: 0;
    opacity: 0;
    transition: opacity 150ms ease-out 0ms;
  }

  .group:hover .blog-card-details-inner,
  .group:focus-visible .blog-card-details-inner,
  .group:active .blog-card-details-inner {
    opacity: 1;
    transition: opacity 400ms var(--ease-fluid) 250ms;
  }

  /* 4. Arrow pop-in: use `transform` (not the Tailwind `scale` property) so the
     shared --engine-transition can animate it together with opacity. */
  .blog-card-arrow {
    opacity: 0;
    transform: scale(0.75);
    pointer-events: none;
  }

  .group:hover .blog-card-arrow,
  .group:focus-visible .blog-card-arrow,
  .group:active .blog-card-arrow {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  /* 5. Generated SVG art is 16:9; center it so its built-in overscan covers
     every card aspect ratio without letterboxing. */
  .blog-card-svg :global(.svg-host) {
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card-blur,
    .blog-card-gradient,
    .blog-card-details,
    .blog-card-details-inner,
    .blog-card-arrow {
      transition: none;
    }
  }
</style>
