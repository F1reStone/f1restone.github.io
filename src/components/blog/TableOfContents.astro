---
/**
 * Table of Contents
 *
 * Auto-generates a TOC from MDX headings. Renders nothing when there are
 * fewer than `minHeadings` headings — keeps short posts uncluttered.
 */
import type { MarkdownHeading } from 'astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { getLocaleFromPath, t } from '@/i18n';
const locale = getLocaleFromPath(Astro.originPathname);

interface Props {
  headings: MarkdownHeading[];
  maxDepth?: 2 | 3 | 4;
  minHeadings?: number;
  title?: string;
  sticky?: boolean;
  /** Native disclosure for the inline/mobile TOC; sidebar behavior is unchanged. */
  collapsible?: boolean;
}

const {
  headings,
  maxDepth = 3,
  minHeadings = 3,
  title = t('blog.toc', locale),
  sticky = false,
  collapsible = false,
} = Astro.props;

const items = headings.filter((h) => h.depth >= 2 && h.depth <= maxDepth);
const shouldRender = items.length >= minHeadings;
const headingId = `toc-heading-${Math.random().toString(36).slice(2, 9)}`;
const Wrapper = collapsible ? 'details' : 'nav';
---

{shouldRender && (
  <Wrapper
    class:list={['toc not-prose', sticky && 'toc-sticky']}
    aria-labelledby={collapsible ? undefined : headingId}
    data-toc
  >
    {collapsible ? (
      <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-foreground [&::-webkit-details-marker]:hidden">
        {title}
        <span class="ml-auto flex items-center gap-1 text-xs text-foreground-muted">
          <span class="toc-show">{t('blog.tocShow', locale)}</span>
          <span class="toc-hide">{t('blog.tocHide', locale)}</span>
          <Icon name="chevron-down" class="toc-chevron h-4 w-4" />
        </span>
      </summary>
    ) : <p
      id={headingId}
      class="text-xs font-semibold uppercase tracking-[0.15em] text-foreground-muted mb-3"
    >
      {title}
    </p>}
    <ul class:list={['space-y-1.5 text-sm border-l border-border relative', collapsible && 'mt-4']}>
      <!-- FireStone: 永久常驻的双节点设计，解决 appendChild 导致的滚动锚定 Bug，支持硬件加速 -->
      <li class="list-none toc-indicator absolute top-0 left-0 w-[4px] rounded-full bg-brand-500 opacity-0" data-toc-ghost aria-hidden="true"></li>
      <li class="list-none toc-indicator absolute top-0 left-0 w-[4px] rounded-full bg-brand-500 opacity-0" data-toc-main aria-hidden="true"></li>
      
      {items.map((h) => (
        <li
          class="toc-item"
          data-depth={h.depth}
          style={`padding-left: ${(h.depth - 2) * 0.875}rem`}
        >
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            data-text={h.text}
            class="weight-shift-non-centered toc-link py-1 pl-3 -ml-px border-l border-transparent text-foreground-muted"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </Wrapper>
)}

<style>
  .toc-hide, details[open] .toc-show { display: none; }
  details[open] .toc-hide { display: inline; }
  .toc-chevron { transition: transform 300ms var(--ease-default); }
  details[open] .toc-chevron { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    .toc-chevron { transition: none; }
    .toc-indicator { transition: none !important; }
  }
  .toc-sticky {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }

  .toc-link {
    font-weight: 400;
  }

  .toc-link:hover, .toc-link:focus-visible {
    color: var(--color-foreground);
    font-weight: 550;
    text-shadow: 0 0 5px currentColor;
  }

  .toc-link[data-active='true'] {
    color: var(--color-foreground);
    font-weight: 700;
    text-shadow: 0 0 10px currentColor;
  }

  /* 仅保留对 GPU 友好的 transform 属性 */
  .toc-indicator {
    will-change: transform;
  }
</style>

<script>
  // =========================================================================
  // FireStone: TOC Animation
  // - Click Lock & Debounce (恢复了解决跨章节跳转和快滑的动效队列堵塞)
  // - Zero DOM insertion (保留了解决滚动条闪烁和 Layout Thrashing)
  // - Pure Scale Morphing 恢复了去除错误的 opacity 渐隐，并恢复物理坍缩
  // =========================================================================
  
  let isJumping = false;
  let scrollStopTimer: ReturnType<typeof setTimeout>;

  // 监听页面滚动：识别“点击跳转”何时结束，恢复 IO 监听
  window.addEventListener('scroll', () => {
    if (isJumping) {
      clearTimeout(scrollStopTimer);
      scrollStopTimer = setTimeout(() => {
        isJumping = false;
      }, 150);
    }
  }, { passive: true });

  const tocs = document.querySelectorAll<HTMLElement>('[data-toc]');
  for (const toc of tocs) {
    // Close a mobile disclosure after choosing a section, retaining native anchor navigation.
    toc.addEventListener('click', (event) => {
      if (toc instanceof HTMLDetailsElement && (event.target as Element).closest('[data-toc-link]')) {
        toc.open = false;
      }
    });
    const links = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
    );
    const mainInd = toc.querySelector<HTMLElement>('[data-toc-main]');
    const ghostInd = toc.querySelector<HTMLElement>('[data-toc-ghost]');
    const slugs = links.map((a) => a.getAttribute('data-toc-link')!);
    const headings = slugs
      .map((s) => document.getElementById(s))
      .filter((el): el is HTMLElement => el !== null);

    if (headings.length === 0) continue;

    let activeSlug = '';
    let currentLink: HTMLAnchorElement | null = null;
    let ioTimeout: ReturnType<typeof setTimeout>;

    const setActive = (slug: string) => {
      if (slug === activeSlug) return;
      activeSlug = slug;
      let newLink: HTMLAnchorElement | null = null;
      
      for (const a of links) {
        const isActive = a.getAttribute('data-toc-link') === slug;
        a.setAttribute('data-active', isActive ? 'true' : 'false');
        if (isActive) newLink = a;
      }

      if (newLink && mainInd && ghostInd) {
        if (!currentLink) {
          // 首次初始化
          mainInd.style.transition = 'none';
          mainInd.style.transform = `translate3d(${newLink.offsetLeft}px, ${newLink.offsetTop}px, 0) scaleY(1)`;
          mainInd.style.height = `${newLink.offsetHeight}px`;
          mainInd.style.opacity = '1';
        } else {
          const oldDepth = currentLink.parentElement!.dataset.depth;
          const newDepth = newLink.parentElement!.dataset.depth;
          const isMovingDown = newLink.offsetTop > currentLink.offsetTop;

          if (oldDepth !== newDepth) {
            /* === WinUI 3 Morphing Animation === */
            // 1. 设置残影(Ghost)的初始状态（替代克隆节点），确保不透明度为 1
            ghostInd.style.transition = 'none';
            ghostInd.style.height = `${currentLink.offsetHeight}px`;
            ghostInd.style.transformOrigin = isMovingDown ? 'center bottom' : 'center top';
            ghostInd.style.transform = `translate3d(${currentLink.offsetLeft}px, ${currentLink.offsetTop}px, 0) scaleY(1)`;
            ghostInd.style.opacity = '1';

            // 2. 设置本体(Main)的初始状态
            mainInd.style.transition = 'none';
            mainInd.style.height = `${newLink.offsetHeight}px`;
            mainInd.style.transformOrigin = isMovingDown ? 'center top' : 'center bottom';
            mainInd.style.transform = `translate3d(${newLink.offsetLeft}px, ${newLink.offsetTop}px, 0) scaleY(0)`;
            mainInd.style.opacity = '1';

            // 强制浏览器应用上述初始帧 (避免动画不生效)
            void ghostInd.offsetWidth;
            void mainInd.offsetWidth;

            // 3. 执行物理动效 (恢复纯 scaleY 缩放，去除 opacity 渐隐，找回 WinUI 质感)
            ghostInd.style.transition = 'transform 500ms var(--ease-fluid)';
            ghostInd.style.transform = `translate3d(${currentLink.offsetLeft}px, ${currentLink.offsetTop}px, 0) scaleY(0)`;

            mainInd.style.transition = 'transform 500ms var(--ease-fluid)';
            mainInd.style.transform = `translate3d(${newLink.offsetLeft}px, ${newLink.offsetTop}px, 0) scaleY(1)`;

          } else {
            /* === Standard Slide === */
            ghostInd.style.opacity = '0'; // 同层级滑动时立刻隐藏残影
            ghostInd.style.transition = 'none';
            
            mainInd.style.transformOrigin = 'center';
            mainInd.style.transition = 'transform 500ms var(--ease-fluid), height 500ms var(--ease-fluid)';
            mainInd.style.height = `${newLink.offsetHeight}px`;
            mainInd.style.transform = `translate3d(${newLink.offsetLeft}px, ${newLink.offsetTop}px, 0) scaleY(1)`;
          }
        }
        
        currentLink = newLink;

        // Auto-scroll 仅在目录本身有滚动条时生效 (完美解决手机端乱滚导致卡死的 Bug)
        if (toc.classList.contains('toc-sticky') && toc.scrollHeight > toc.clientHeight) {
          const linkRect = newLink.getBoundingClientRect();
          const tocRect = toc.getBoundingClientRect();
          const padding = 12;
          let delta = 0;
          if (linkRect.top < tocRect.top + padding) {
            delta = linkRect.top - tocRect.top - padding;
          } else if (linkRect.bottom > tocRect.bottom - padding) {
            delta = linkRect.bottom - tocRect.bottom + padding;
          }
          if (delta !== 0) {
            toc.scrollBy({ top: delta, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
          }
        }
      }
    };

    // Closed disclosures have no measurable link geometry; refresh after opening.
    if (toc instanceof HTMLDetailsElement) {
      toc.addEventListener('toggle', () => {
        if (!toc.open) return;
        const slug = activeSlug || slugs[0];
        activeSlug = '';
        currentLink = null;
        if (ghostInd) ghostInd.style.opacity = '0';
        setActive(slug);
      });
    }

    // 点击锁定逻辑 (恢复！)
    links.forEach(link => {
      link.addEventListener('click', () => {
        isJumping = true; // 锁定滚动嗅探
        const slug = link.getAttribute('data-toc-link');
        if (slug) setActive(slug); // 瞬间触发目标动画，安静等待页面滚到位
      });
    });

    const io = new IntersectionObserver(
      (entries) => {
        if (isJumping) return; // 锁定状态无视嗅探

        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          
        if (visible.length > 0 && visible[0].target.id) {
          const targetId = visible[0].target.id;
          
          // 防抖逻辑 (恢复！) 降低快速滚动时的性能开销
          clearTimeout(ioTimeout);
          ioTimeout = setTimeout(() => {
            setActive(targetId);
          }, 50);
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );

    for (const h of headings) io.observe(h);
  }
</script>
