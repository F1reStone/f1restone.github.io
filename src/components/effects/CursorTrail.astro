---
/**
 * CursorTrail
 * Three layers behind a single cursor:
 *  1. Dot at the pointer (precise indicator)
 *  2. Lagging ring (elastic follow, blooms on hover)
 *  3. Comet-trail particles (spawn behind movement, fade out)
 *
 * Intentionally desktop-only:
 *  - Skipped on (hover: none) / (pointer: coarse) devices
 *  - Skipped on prefers-reduced-motion
 *  - Native cursor stays visible — this is purely additive
 */

const PARTICLE_COUNT = 16;
---

<style is:global>
  /* FireStone: 当自定义光标被成功激活时，强制隐藏全局系统光标 */
  html.custom-cursor-active,
  html.custom-cursor-active * {
    cursor: none !important;
  }
</style>

<div
  id="cursor-dot"
  aria-hidden="true"
  class="cursor-fx fixed top-0 left-0 z-[9999] h-2.5 w-2.5 rounded-full bg-brand-500 opacity-0 will-change-transform pointer-events-none shadow-[0_0_8px_var(--color-brand-500)]"
></div>

<div
  id="cursor-ring-wrap"
  aria-hidden="true"
  class="cursor-fx fixed top-0 left-0 z-[9999] opacity-0 will-change-transform pointer-events-none"
>
  <div
    id="cursor-ring"
    class="h-10 w-10 rounded-full border-2 border-brand-500/80 origin-center transition-all duration-300 ease-[cubic-bezier(0.25,1,0.5,1)]"
  ></div>
</div>

{Array.from({ length: PARTICLE_COUNT }).map(() => (
  <div
    aria-hidden="true"
    class="cursor-trail-particle cursor-fx fixed top-0 left-0 z-[9998] h-1.5 w-1.5 rounded-full bg-brand-500 opacity-0 will-change-transform pointer-events-none"
  ></div>
))}

<style>
  @media (hover: none), (pointer: coarse) {
    .cursor-fx { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor-fx { display: none !important; }
  }

  /* FireStone: 悬停时，光标环放大，不仅填充背景，还要爆发出同款品牌色辉光！ */
  #cursor-ring.is-hovering {
    transform: scale(1.6);
    background-color: color-mix(in oklch, var(--color-brand-500) 25%, transparent);
    border-color: var(--color-brand-500);
    box-shadow: 0 0 16px var(--color-brand-500);
  }
</style>

<script is:inline>
  (function () {
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // FireStone: 通知 CSS，设备支持且已开启自定义光标，可以隐藏原生鼠标了
    document.documentElement.classList.add('custom-cursor-active');

    const dot = document.getElementById('cursor-dot');
    const ringWrap = document.getElementById('cursor-ring-wrap');
    const ring = document.getElementById('cursor-ring');
    if (!dot || !ringWrap || !ring) return;

    const particleEls = document.querySelectorAll('.cursor-trail-particle');
    const particles = [];
    for (let i = 0; i < particleEls.length; i++) {
      particles.push({ el: particleEls[i], life: 0, x: 0, y: 0 });
    }
    let particleIdx = 0;
    let lastSpawn = 0;
    const SPAWN_INTERVAL = 22; 
    const FADE_RATE = 0.025;   

    const INTERACTIVE = 'a, button, [role="button"], input:not([type="hidden"]), textarea, select, summary, label[for]';
    let mouseX = -100, mouseY = -100;
    let ringX = -100, ringY = -100;
    let visible = false;
    let hovering = null;

    function onMove(e) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!visible) {
        visible = true;
        dot.style.opacity = '1';
        ringWrap.style.opacity = '1';
      }
      
      /* FireStone: 性能优化
         使用 translate3d 激活 GPU 独立图层硬件加速
         使光标的移动也完全在 GPU 合成器上跑
      */
      dot.style.transform = 'translate3d(' + (mouseX - 5) + 'px,' + (mouseY - 5) + 'px, 0)';

      const now = performance.now();
      if (now - lastSpawn >= SPAWN_INTERVAL) {
        lastSpawn = now;
        const p = particles[particleIdx];
        p.x = mouseX;
        p.y = mouseY;
        p.life = 1;
        particleIdx = (particleIdx + 1) % particles.length;
      }
    }

    function onLeave() {
      visible = false;
      dot.style.opacity = '0';
      ringWrap.style.opacity = '0';
    }

    function syncHover(e) {
      const target = e.target.closest ? e.target.closest(INTERACTIVE) : null;
      if (target !== hovering) {
        hovering = target;
        ring.classList.toggle('is-hovering', !!target);
      }
    }

    function tick() {
      ringX += (mouseX - ringX) * 0.18;
      ringY += (mouseY - ringY) * 0.18;
      
      // FireStone: 同步应用 translate3d 到跟踪环
      ringWrap.style.transform = 'translate3d(' + (ringX - 20) + 'px,' + (ringY - 20) + 'px, 0)';

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        if (p.life <= 0) continue;
        p.life -= FADE_RATE;
        if (p.life < 0) p.life = 0;
        const op = p.life * 0.7; 
        const sc = 0.4 + p.life * 0.6; 
        p.el.style.opacity = String(op);
        
        // FireStone: 同步应用 translate3d 到拖尾
        p.el.style.transform =
          'translate3d(' + (p.x - 3) + 'px,' + (p.y - 3) + 'px, 0) scale(' + sc + ')';
      }

      requestAnimationFrame(tick);
    }

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseover', syncHover);
    document.addEventListener('mouseout', syncHover);
    document.addEventListener('mouseleave', onLeave);
    requestAnimationFrame(tick);
  })();
</script>