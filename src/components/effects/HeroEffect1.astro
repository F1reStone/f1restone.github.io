---
import { heroEffect1Defaults, type HeroEffect1Options } from './hero-effect-1/types';

interface Props extends Partial<HeroEffect1Options> {
  class?: string;
}
const { class: className, ...params } = Astro.props;
const options = { ...heroEffect1Defaults, ...params };
const stops = options.gradient.stops
  .map(
    ({ position, color }) =>
      `rgba(${color.r * 255}, ${color.g * 255}, ${color.b * 255}, ${color.a}) ${position * 100}%`
  )
  .join(', ');
const customPalette = params.gradient !== undefined;
---

<firestone-hero-effect-1
  class:list={['hero-effect-1 pointer-events-none absolute inset-0 overflow-hidden', className]}
  data-hero-effect-1
  data-options={JSON.stringify(options)}
  style={`--hero-effect-1-fallback: linear-gradient(130deg, ${stops});`}
  aria-hidden="true"
>
  <div class="hero-effect-1__fallback">
    {
      !customPalette && (
        <picture>
          <source media="(max-aspect-ratio: 1/1)" srcset="/images/hero-effect-1-portrait.webp" />
          <img
            src="/images/hero-effect-1-landscape.webp"
            alt=""
            width="1440"
            height="900"
            decoding="async"
          />
        </picture>
      )
    }
  </div>
</firestone-hero-effect-1>

<style>
  .hero-effect-1 {
    display: block;
    z-index: 0;
    contain: layout paint;
    background: var(--hero-effect-1-fallback);
  }
  .hero-effect-1__fallback {
    position: absolute;
    inset: 0;
    background: var(--hero-effect-1-fallback);
  }
  .hero-effect-1__fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-effect-1[data-renderer='webgpu'] .hero-effect-1__fallback {
    visibility: hidden;
  }
  .hero-effect-1 :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import './hero-effect-1/element';
</script>
