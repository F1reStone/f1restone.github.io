---
import { Picture } from 'astro:assets';
import landscapeFallback from '@/assets/index/hero-effect-1-landscape.png';
import portraitFallback from '@/assets/index/hero-effect-1-portrait.png';
import { heroEffect1Defaults, type HeroEffect1Options } from './hero-effect-1/types';

interface Props extends Partial<HeroEffect1Options> {
  class?: string;
}
const { class: className, ...params } = Astro.props;
const options = { ...heroEffect1Defaults, ...params };
const stops = options.gradient.stops
  .map(
    ({ position, color }) =>
      `rgba(${color.r * 255}, ${color.g * 255}, ${color.b * 255}, ${color.a}) ${position * 100}%`
  )
  .join(', ');
const customPalette = params.gradient !== undefined;
const fallbackImages = [
  { src: landscapeFallback, widths: [720, 1440], orientation: 'landscape' },
  { src: portraitFallback, widths: [390], orientation: 'portrait' },
];
const fallbackProps = {
  alt: '',
  fallbackFormat: 'webp' as const,
  quality: 95,
  sizes: '100vw',
  layout: 'none' as const,
  loading: 'eager' as const,
  decoding: 'async' as const,
};
---

<firestone-hero-effect-1
  class:list={['hero-effect-1 pointer-events-none absolute inset-0 overflow-hidden', className]}
  data-hero-effect-1
  data-options={JSON.stringify(options)}
  style={`--hero-effect-1-fallback: linear-gradient(130deg, ${stops});`}
  aria-hidden="true"
>
  <div class="hero-effect-1__fallback">
    {
      !customPalette &&
        fallbackImages.map(({ src, widths, orientation }) => (
          <Fragment>
            <template data-hero-fallback={orientation}>
              <Picture
                {...fallbackProps}
                formats={['avif', 'webp']}
                src={src}
                widths={widths}
                pictureAttributes={{ class: `hero-effect-1__picture--${orientation}` }}
              />
            </template>
            <noscript>
              <Picture
                {...fallbackProps}
                formats={['avif', 'webp']}
                src={src}
                widths={widths}
                pictureAttributes={{ class: `hero-effect-1__picture--${orientation}` }}
              />
            </noscript>
          </Fragment>
        ))
    }
  </div>
</firestone-hero-effect-1>

<style>
  .hero-effect-1 {
    display: block;
    z-index: 0;
    contain: layout paint;
    background: var(--hero-effect-1-fallback);
  }
  .hero-effect-1__fallback {
    position: absolute;
    inset: 0;
    background: var(--hero-effect-1-fallback);
  }
  .hero-effect-1__fallback :global(picture) {
    display: block;
    position: absolute;
    inset: 0;
  }
  .hero-effect-1__fallback :global(.hero-effect-1__picture--portrait) {
    display: none;
  }
  .hero-effect-1__fallback :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-aspect-ratio: 1/1) {
    .hero-effect-1__fallback :global(.hero-effect-1__picture--landscape) {
      display: none;
    }
    .hero-effect-1__fallback :global(.hero-effect-1__picture--portrait) {
      display: block;
    }
  }
  .hero-effect-1[data-renderer='webgpu'] .hero-effect-1__fallback {
    visibility: hidden;
  }
  .hero-effect-1 :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import './hero-effect-1/element';
</script>
