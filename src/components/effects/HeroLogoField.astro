---
import { heroLogoFieldDefaults, type HeroLogoFieldOptions } from './hero-logo-field/types';

interface Props extends Partial<HeroLogoFieldOptions> {
  class?: string;
}

const {
  class: className,
  background = heroLogoFieldDefaults.background,
  color = heroLogoFieldDefaults.color,
  highlight = heroLogoFieldDefaults.highlight,
  speed = heroLogoFieldDefaults.speed,
  seed = heroLogoFieldDefaults.seed,
} = Astro.props;
const options = { background, color, highlight, speed, seed };
---

<firestone-logo-field
  class:list={['hero-logo-field pointer-events-none absolute inset-0 overflow-hidden', className]}
  data-hero-logo-field
  data-options={JSON.stringify(options)}
  style={`--hero-field-background: ${options.background}; --hero-field-color: ${options.color};`}
  aria-hidden="true"
>
  <img
    class="hero-logo-field__poster"
    src="/images/firestone-light-trails.webp"
    alt=""
    width="3200"
    height="2000"
    fetchpriority="high"
  />
  <span class="hero-logo-anchor"></span>
</firestone-logo-field>

<style>
  .hero-logo-field {
    display: block;
    z-index: 0;
    background: var(--hero-field-background, #000102);
    contain: layout paint;
  }

  .hero-logo-anchor {
    position: absolute;
    left: 50%;
    top: var(--hero-logo-center-y, 36%);
    width: var(--hero-logo-size, 300px);
    height: var(--hero-logo-size, 300px);
    transform: translate(-50%, -50%);
    visibility: hidden;
  }

  .hero-logo-field__poster {
    position: absolute;
    left: 50%;
    top: var(--hero-logo-center-y, 36%);
    width: calc(var(--hero-logo-size, 300px) * 10);
    max-width: none;
    height: auto;
    transform: translate(-50%, -50%);
    opacity: 0.9;
  }

  .hero-logo-field[data-renderer='webgl'] .hero-logo-field__poster {
    visibility: hidden;
  }

  .hero-logo-field :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import './hero-logo-field/element';
</script>
