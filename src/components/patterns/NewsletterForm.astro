---
import Input from '@/components/ui/form/Input/Input.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { cn } from '@/lib/cn';
import { t, getLocaleFromPath } from '@/i18n';

interface Props {
  action?: string;
  placeholder?: string;
  buttonText?: string;
  successMessage?: string;
  heading?: string;
  description?: string;
  note?: string;
  size?: 'sm' | 'md' | 'lg';
  layout?: 'auto' | 'stacked';
  buttonClass?: string;
  class?: string;
}

const locale = getLocaleFromPath(Astro.originPathname);

const {
  action,
  placeholder = t('newsletter.emailPlaceholder', locale),
  buttonText = t('newsletter.subscribe', locale),
  successMessage = t('newsletter.success', locale),
  heading, description, note, size = 'md', layout = 'auto', buttonClass,
  class: className,
} = Astro.props;
---

<form
  class={cn('newsletter-form', className)}
  action={action}
  method="POST"
  data-success-message={successMessage}
  data-subscribing={t('newsletter.subscribing', locale)}
  data-generic-error={t('newsletter.genericError', locale)}
  data-error-message={t('newsletter.error', locale)}
>
  {heading && <p class="mb-1 text-base font-semibold text-foreground">{heading}</p>}
  {description && <p class="mb-4 text-sm text-foreground-muted">{description}</p>}
  <div class:list={['flex flex-col gap-3', layout === 'auto' && 'sm:flex-row sm:items-start']}>
    <div class="min-w-0 flex-1">
      <Input
        name="email"
        aria-label={t('contact.email', locale)}
        type="email"
        size={size}
        placeholder={placeholder}
        required
        autocomplete="email"
      />
    </div>
    <Button type="submit" size={size} class={cn('newsletter-submit shrink-0', buttonClass)} disabled={!action}>
      {buttonText}
    </Button>
  </div>

  <div class="hidden" aria-hidden="true"><input type="text" name="honeypot" tabindex="-1" autocomplete="off" /></div>
  {!action && <p class="mt-3 text-sm text-foreground-muted">{t(import.meta.env.DEV ? 'newsletter.notConfigured' : 'newsletter.unavailable', locale)}</p>}
  <!-- Reserve space so feedback does not move adjacent controls or footer links. -->
  <p class="newsletter-message mt-3 min-h-5 text-sm" role="status"></p>
  {note && <p class="mt-2 text-xs text-foreground-muted">{note}</p>}
</form>

<script>
  function initNewsletterForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('.newsletter-form');

    forms.forEach((form) => {
      const button = form.querySelector('.newsletter-submit') as HTMLButtonElement;
      const message = form.querySelector('.newsletter-message') as HTMLParagraphElement;

      if (!button || !message) return;

      const successMessage = form.dataset.successMessage || 'Thanks for subscribing!';
      if (form.dataset.initialized) return;
      form.dataset.initialized = 'true';
      const originalText = button.textContent || 'Subscribe';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.getAttribute('action')) return;

        button.disabled = true;
        button.textContent = form.dataset.subscribing || 'Subscribing…';
        message.textContent = '';
        message.classList.remove('text-success', 'text-destructive');

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });

          const data = await response.json();

          if (data.success) {
            message.textContent = successMessage;
            message.classList.add('text-success');
            form.reset();
          } else {
            message.textContent = data.error || form.dataset.genericError || 'Something went wrong';
            message.classList.add('text-destructive');
          }
        } catch {
          message.textContent = form.dataset.errorMessage || 'Subscription failed. Please try again.';
          message.classList.add('text-destructive');
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });
    });
  }

  initNewsletterForms();
  document.addEventListener('astro:after-swap', initNewsletterForms);
</script>
