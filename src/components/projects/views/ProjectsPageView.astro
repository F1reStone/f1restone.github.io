---
import { buildBreadcrumbs } from '@/lib/breadcrumbs';
import siteConfig from '@/config/site.config';
import { t } from '@/i18n';
import { defaultLocale, localizedPath } from '@/i18n';
interface Props { locale?: string; page: number; totalPages: number; }
const { locale = defaultLocale } = Astro.props;
/**
 * Paginated projects listing
 * URL: /projects/page/<n> (page 1 lives at /projects)
 *
 * Mirrors the blog pagination so the two listings behave identically.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import TagList from '@/components/blog/TagList.astro';
import Pagination from '@/components/blog/Pagination.astro';
import {
  collectTopProjectTags,
  getVisibleProjects,
  getProjectTagUrl,
  PROJECT_TAG_CLOUD_LIMIT,
  PROJECTS_PER_PAGE,
} from '@/lib/projects';



const { page, totalPages } = Astro.props;

const projects = await getVisibleProjects(locale);
const start = (page - 1) * PROJECTS_PER_PAGE;
const pageProjects = projects.slice(start, start + PROJECTS_PER_PAGE);

const topTags = collectTopProjectTags(projects, PROJECT_TAG_CLOUD_LIMIT);
---

<PageLayout
  breadcrumbs={buildBreadcrumbs(t('pagination.pageLabel', locale, { page }), Astro.url.pathname, locale, 'projects')}
  title={t('projects.pageMetaTitle', locale, { page })}
  description={t('projects.pageMetaDescription', locale, { page, total: totalPages })}
  eagerReveal
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      {t('projects.pageBadge', locale, { page, total: totalPages })}
    </Badge>

    <h1 slot="title">{t('projects.title', locale)}</h1>

    <p slot="description">
      {t('projects.heroDescription', locale)}
    </p>
  </Hero>

  <section class="bg-background py-[var(--space-section-md)]">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4" data-reveal>
        <Button variant="outline" href={localizedPath('/projects/', locale)} data-reveal>
          <Icon name="chevron-left" size="sm" />
          {t('projects.tagBackToAll', locale)}
        </Button>

        {topTags.length > 0 && (
          <TagList locale={locale} tags={topTags} hrefForTag={getProjectTagUrl} class="justify-center" />
        )}
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {pageProjects.map((project, i) => (
          <ProjectCard locale={locale} project={project} index={i} />
        ))}
      </div>

      <Pagination
        currentPage={page}
        totalPages={totalPages}
        href={(p) => localizedPath(p === 1 ? '/projects' : `/projects/page/${p}`, locale)}
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background">
    <!-- Mobile: flat section, no card -->
    <div class="glitch:hidden mx-auto max-w-2xl px-6 text-center" data-reveal>
      <Badge variant="brand" pill class="mb-6">{t('projects.ctaBadge', locale)}</Badge>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {t('projects.ctaHeading', locale)}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {t('projects.ctaLead', locale)}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={`mailto:${siteConfig.email}`} variant="primary">
          {t('projects.ctaPrimary', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href={localizedPath('/about', locale)}>
          {t('projects.ctaSecondary', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>

    <!-- Desktop: contained LetterGlitch band with glass card -->
    <LetterGlitchBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {t('projects.ctaHeading', locale)}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {t('projects.ctaLead', locale)}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={`mailto:${siteConfig.email}`} variant="primary">
          {t('projects.ctaPrimary', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href={localizedPath('/about', locale)}>
          {t('projects.ctaSecondary', locale)}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </LetterGlitchBand>
  </section>
</PageLayout>
