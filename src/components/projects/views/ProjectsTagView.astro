---
import { buildBreadcrumbs } from '@/lib/breadcrumbs';
import { t } from '@/i18n';
import { defaultLocale, localizedPath } from '@/i18n';
interface Props { locale?: string; tag: string; projects: import('astro:content').CollectionEntry<'projects'>[]; visibleTags: string[]; }
const { locale = defaultLocale } = Astro.props;
/**
 * Project tag archive
 * URL: /projects/tag/<slug>
 */
import PageLayout from '@/layouts/PageLayout.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import TagList from '@/components/blog/TagList.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import { getProjectTagUrl } from '@/lib/projects';



const { tag, projects, visibleTags } = Astro.props;
---

<PageLayout
  breadcrumbs={buildBreadcrumbs(tag, Astro.url.pathname, locale, 'projects')}
  title={t('projects.tagMetaTitle', locale, { tag })}
  description={t('projects.tagMetaDescription', locale, { tag })}
  eagerReveal
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="tag" size="sm" />
      {t('projects.tagBadge', locale)}
    </Badge>

    <h1
      slot="title"
      class="!text-4xl sm:!text-5xl md:!text-6xl lg:!text-7xl break-words [overflow-wrap:anywhere]"
    >#{tag}</h1>

    <p slot="description">
      {t(projects.length === 1 ? 'projects.tagCountOne' : 'projects.tagCountOther', locale, { count: projects.length, tag })}
    </p>
  </Hero>

  <section class="bg-background py-[var(--space-section-md)]">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4" data-reveal>
        <Button variant="outline" href={localizedPath('/projects/', locale)} data-reveal>
          <Icon name="chevron-left" size="sm" />
          {t('projects.tagBackToAll', locale)}
        </Button>

        {visibleTags.length > 0 && (
          <TagList locale={locale} tags={visibleTags} active={tag} hrefForTag={getProjectTagUrl} class="justify-center" />
        )}
      </div>

      {projects.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {projects.map((project, i) => (
            <ProjectCard locale={locale} project={project} index={i} />
          ))}
        </div>
      ) : (
        <div class="py-16 text-center">
          <div class="bg-background mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full">
            <Icon name="layers" size="lg" class="text-foreground-muted" />
          </div>
          <p class="text-foreground-muted text-lg">{t('projects.tagEmpty', locale)}</p>
          <div class="mt-6">
            <Button href={localizedPath('/projects', locale)} variant="outline" size="sm">
              <Icon name="arrow-left" size="sm" />
              {t('projects.tagBackToAll', locale)}
            </Button>
          </div>
        </div>
      )}
    </div>
  </section>
</PageLayout>
