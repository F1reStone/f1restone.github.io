---
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import ProjectCarousel from '@/components/projects/ProjectCarousel.astro';
import type { GallerySlide } from '@/lib/gallery';

interface Props {
  title: string;
  description: string;
  meta?: string[];
  year?: number;
  client?: string;
  role?: string;
  services?: string[];
  url?: string;
  repo?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  gallery?: GallerySlide[];
  tags?: string[];
  /**
   * Optional project logo — when provided, it replaces the text title.
   * Multi-colour and gradient SVGs are fully supported.  Design your SVG
   * for the dark theme (the site default); a CSS filter auto-adapts it
   * for light-mode visitors.  For pixel-perfect results, embed a
   * `<style>` block with `@media (prefers-color-scheme: light)` inside
   * the SVG file itself.
   */
  logo?: ImageMetadata;
}

const {
  title,
  description,
  meta = [],
  year: _year,
  client: _client,
  role: _role,
  services: _services = [],
  url,
  repo,
  image,
  imageAlt,
  gallery = [],
  tags = [],
  logo,
} = Astro.props;

// Prefer gallery when provided; fall back to the single hero image; build a
// 1-slide carousel out of the image so the visual frame stays consistent.
const slides: GallerySlide[] =
  gallery.length > 0
    ? gallery
    : image
      ? [{ src: image, alt: imageAlt || title }]
      : [];
const hasMedia = slides.length > 0;
---

<header class="relative isolate overflow-hidden pt-[var(--space-page-top-sm)] pb-[var(--space-section-md)]">

  <div class="relative z-10 mx-auto max-w-8xl px-6">
    <div
      class:list={[
        'grid items-center gap-10',
        'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14',
      ]}
    >
      <!-- Text column -->
      <div class="animate-hero-stagger min-w-0">
        <!-- Project logo — rendered as <img> so multi-colour and gradient SVGs
             work without forced monochrome.
             Dark/light adaptation: CSS `filter` inverts the logo in light mode
             (html:not(.dark)).  Design your SVG for the *dark* theme (the site
             default); the filter handles light-mode visitors automatically.
             Sizing: control via CSS max-height; the aspect-ratio from the
             source SVG keeps proportions correct. -->
        {logo ? (
          <>
            <h1 class="sr-only">{title}</h1>
            <img
              src={logo.src}
              alt={title}
              width={logo.width}
              height={logo.height}
              class="project-logo block h-auto w-auto max-w-full object-contain object-left max-h-14 md:max-h-16 lg:max-h-[4.5rem] mb-[var(--space-heading-gap)]"
              decoding="async"
            />
          </>
        ) : (
          <h1 class="font-display text-4xl font-bold tracking-tight text-foreground md:text-5xl lg:text-6xl mb-[var(--space-heading-gap)] text-balance">
            {title}
          </h1>
        )}

        <p class="text-lg md:text-xl text-foreground-muted leading-relaxed mb-[var(--space-stack-lg)]">
          {description}
        </p>

        {meta.length > 0 && (
          <div class="mb-[var(--space-stack-lg)] flex flex-wrap items-center gap-2">
            {meta.map((item, index) => (
              <>
                {/* FireStone: [Replace text character '·' with precise geometric dot separator] */}
                {index > 0 && <span class="h-0.5 w-0.5 rounded-full bg-foreground-subtle/50 shrink-0" aria-hidden="true" />}
                <Badge variant="brand">
                  {item}
                </Badge>
              </>
            ))}
          </div>
        )}

        {(url || repo) && (
          <div class="flex flex-wrap gap-3 mb-[var(--space-stack-lg)]">
            {url && (
              <Button href={url} target="_blank" rel="noopener noreferrer" size="md">
                <Icon name="globe" size="sm" />
                访问网站
              </Button>
            )}
            {repo && (
              <Button href={repo} target="_blank" rel="noopener noreferrer" variant="outline" size="md">
                <Icon name="github" size="sm" />
                访问源代码
                <Icon name="external-link" size="xs" />
              </Button>
            )}
          </div>
        )}
      </div>

      <!-- Media column (carousel, single image, or branded placeholder) -->
      <div class="animate-hero-slide-up [animation-delay:300ms]">
        {hasMedia ? (
          <ProjectCarousel slides={slides} label={`${title} screenshots`} />
        ) : (
          <div
            class="aspect-video w-full rounded-xl border border-border bg-gradient-to-br from-brand-500/20 via-brand-500/5 to-transparent flex items-center justify-center shadow-lg"
            aria-hidden="true"
          >
            <Icon name="layers" size="lg" class="text-brand-500/60" />
          </div>
        )}
      </div>
    </div>
  </div>
</header>

<style>
  /* Light-mode logo inversion: the site defaults to dark mode, so SVGs are
     authored with light fills.  In light mode we invert+hue-rotate to
     produce dark fills while approximately preserving brand hues.
     For pixel-perfect results, add a <style> block with
     @media (prefers-color-scheme: light) inside your SVG — that beats the
     filter every time. */
  html:not(.dark) .project-logo {
    filter: invert(1) hue-rotate(180deg);
  }
</style>
