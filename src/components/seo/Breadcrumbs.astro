---
import { cn } from '@/lib/cn';
import { t, getLocaleFromPath } from '@/i18n';
import type { BreadcrumbItem } from '@/lib/breadcrumbs';

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
---


<nav aria-label={t('common.breadcrumb', locale)} class={cn('text-sm', className)}>
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <svg
              class="h-4 w-4 text-foreground-muted opacity-50"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
          {item.href && index !== items.length - 1 ? (
            <a href={item.href} class="text-foreground-muted hover-glow-text weight-shift hover:text-foreground transition-colors duration-200">
              {item.label}
            </a>
          ) : (
            <span class="text-foreground text-shadow-[0_0_10px_currentColor] font-bold" aria-current={index === items.length - 1 ? 'page' : undefined}>
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
