---
import { defaultLocale, localizedPath, getLocaleFromPath } from '@/i18n';
interface Props {
  locale?: string;
}
const { locale = defaultLocale } = Astro.props;
const requestedLocale = getLocaleFromPath(Astro.originPathname);
Astro.locals.contentLocale = defaultLocale;
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import TypingEffect from '@/components/ui/TypingEffect.astro';
import { getFeaturedContent } from '@/lib/page-content';
import { withLocaleFallback } from '@/lib/locale-fallback';
import { getPostUrl } from '@/lib/blog';

const { projects: projectItems, posts: blogItems } = await getFeaturedContent(locale);
const featuredProjects = projectItems
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const posts = blogItems
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 4);
---

<LandingLayout
  title="首页"
  description="兴趣使然的业余开发者 / 设计师 / 内容创作者「FireStone 火石」的个人网站。在这里分享一些我的有趣作品和技术心得。"
  includePersonSchema={true}
>
  <!-- Hero -->
  <Hero layout="split" size="xl" class="invert-section" fullHeight showEffect1 showScrollIndicator>
    <h1
      slot="title"
      class="hero-title-wrapper relative z-10 !text-4xl tracking-normal sm:!text-6xl md:!text-7xl lg:!text-8xl"
    >
      <span class="hero-title-text text-[0.6em] whitespace-nowrap">To the</span>
      <br />
      <span class="hero-title-text">Infinite Future</span>
    </h1>

    <Fragment slot="actions">
      <Button size="lg" href={localizedPath('/about', requestedLocale) + ''}>
        关于我
        <Icon name="chevron-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href={localizedPath('/projects', requestedLocale) + ''}>
        探索我的项目
        <Icon name="chevron-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Portfolio -->
  <section id="work" class="bg-background border-border relative z-10 py-[var(--space-section-md)]">
    <div class="max-w-8xl mx-auto flex flex-col gap-8 px-6">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <h2 class="font-display text-foreground text-3xl font-bold md:text-4xl">项目与作品</h2>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {featuredProjects.map((project, i) => (
          <ProjectCard locale={requestedLocale} project={project} index={i} />
        ))}
      </div>

      <div class="mt-4 text-center">
        <Button variant="outline" href={localizedPath('/projects', requestedLocale) + ''}>
          查看更多项目
          <Icon name="chevron-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  {/* About Teaser — a site-width rounded window that expands to full-bleed as it pins. */}
  <section
    class="about-expand bg-background relative z-10"
    data-about-expand
    aria-labelledby="home-about-heading"
  >
    <div class="about-expand-stage">
      <div class="about-expand-sticky">
        <div class="about-expand-surface" aria-hidden="true"></div>
        <div class="about-expand-content relative mx-auto w-full">
          <div class="grid gap-12 lg:grid-cols-2">
            <div class="flex flex-col justify-center" data-reveal="right" data-reveal-ease="smooth">
              <div class="mb-6 flex flex-col gap-6">
                <Badge variant="brand" pill class="self-start">
                  关于 FireStone
                </Badge>
                <h2
                  id="home-about-heading"
                  class="font-display text-foreground text-3xl font-bold md:text-4xl"
                >
                  一位兴趣使然的
                  <br />
                  <span class="text-brand-500">
                    <TypingEffect
                      words={[
                        '业余设计师',
                        '业余开发者',
                        '内容创作者',
                        '业余技术美术师',
                        '《THE FINALS》选手',
                        '奇袭者',
                        'Sensei',
                        '豪华版《战地风云 5》预购冤种',
                        '（前）特勤干员',
                        '《赛博朋克 2077》预购冤种',
                        '《边境》首发冤种',
                      ]}
                    />
                  </span>
                </h2>
              </div>
              <Button
                variant="outline"
                href={localizedPath('/about', requestedLocale) + ''}
                class="self-start"
              >
                进一步了解
                <Icon name="chevron-right" size="sm" />
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="bg-background border-border relative z-10 py-[var(--space-section-md)]">
    <div class="max-w-8xl mx-auto flex flex-col gap-8 px-6">
      <div class="flex flex-col items-center gap-6 text-center" data-reveal>
        <h2 class="font-display text-foreground text-3xl font-bold md:text-4xl">推荐文章</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            body={post.body}
            locale={locale}
            href={withLocaleFallback(
              getPostUrl(post.id, post.data.locale),
              post.data.locale,
              requestedLocale
            )}
            publishedAt={post.data.publishedAt}
            tags={post.data.tags}
            author={post.data.author}
            image={post.data.image}
            svgSlug={post.data.svgSlug}
            revealDelay={index}
            class={index === 3 ? 'hidden sm:block lg:hidden' : undefined}
          />
        ))}
      </div>

      <div class="flex justify-center">
        <Button variant="outline" href={localizedPath('/blog', requestedLocale) + ''}>
          阅读所有文章
          <Icon name="chevron-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <style>
    /* The About teaser is a sticky stage: the initial state is a rounded
       window sized to the site container, and scrolling the pin distance
       expands its clipped surface to the full viewport. The surface is
       absolutely positioned behind the content, so the expansion never
       reflows the page. */
    .about-expand {
      --about-expand-progress: 0;
      --about-expand-distance: 52svh;
      --about-expand-radius: clamp(1.5rem, 3.5vw, 3.5rem);
      --about-expand-window-width: min(calc(100% - 3rem), max(70rem, 90%));
      --about-expand-inset-x: calc((100% - var(--about-expand-window-width)) / 2);
    }

    .about-expand-stage {
      position: relative;
      height: calc(100svh + var(--about-expand-distance));
    }

    .about-expand-sticky {
      position: sticky;
      top: 0;
      display: flex;
      height: 100svh;
      align-items: center;
      overflow: clip;
    }

    .about-expand-content {
      position: relative;
      /* Match the initial window width so the inner gutter is measured from
         the rounded edge, not from the viewport edge on narrow screens. */
      max-width: var(--about-expand-window-width);
      padding-block: var(--space-section-md);
      /* Keep the content visibly inside the rounded window rather than letting
         it ride the section's normal 24px gutter. */
      padding-inline: clamp(1.75rem, 6vw, 6rem);
    }

    /* The narrower phone column needs a smaller display size for the long
       typing phrase to stay inside the rounded window. Only the pinned mode
       gets the reduced content width; the static fallback keeps its original
       full-width heading. */
    @media (max-width: 639px) and (prefers-reduced-motion: no-preference) and (min-height: 621px) {
      .about-expand #home-about-heading {
        font-size: clamp(1.2rem, 6.2vw, 2.25rem);
        line-height: 1.2;
      }
    }

    .about-expand-surface {
      position: absolute;
      inset: 0;
      border-radius: calc(var(--about-expand-radius) * (1 - var(--about-expand-progress)));
      background:
        radial-gradient(
          75% 110% at 10% 12%,
          color-mix(in oklch, var(--color-brand-500) 10%, transparent),
          transparent 62%
        ),
        linear-gradient(160deg, var(--color-background-secondary), var(--color-background));
      clip-path: inset(
        calc(clamp(1.5rem, 15svh, 8rem) * (1 - var(--about-expand-progress)))
          calc(var(--about-expand-inset-x) * (1 - var(--about-expand-progress))) round
          calc(var(--about-expand-radius) * (1 - var(--about-expand-progress)))
      );
      will-change: clip-path;
    }

    .about-expand-surface::after {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px solid var(--color-border);
      border-radius: inherit;
      opacity: calc(1 - var(--about-expand-progress));
      pointer-events: none;
    }

    /* Short viewports and reduced-motion users keep the original flat,
       full-bleed section instead of a pinned scroll interaction. */
    @media (prefers-reduced-motion: reduce), (max-height: 620px) {
      .about-expand-stage {
        height: auto;
      }

      .about-expand-sticky {
        position: relative;
        display: block;
        height: auto;
        overflow: visible;
      }

      .about-expand-surface {
        border-radius: 0;
        border-top: 1px solid var(--color-border);
        clip-path: none;
        will-change: auto;
      }

      .about-expand-surface::after {
        opacity: 0;
      }

      /* Restore the original full-bleed content alignment when the pinned
         interaction is disabled. */
      .about-expand-content {
        max-width: max(70rem, 90%);
        padding-inline: 1.5rem;
      }
    }
  </style>

  <script>
    function initAboutExpansion() {
      const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-about-expand]'));
      if (sections.length === 0) return;

      const staticMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce), (max-height: 620px)'
      );
      const states = sections.map((section) => ({
        section,
        stage: section.querySelector<HTMLElement>('.about-expand-stage'),
        top: 0,
        distance: 1,
        progress: -1,
      }));
      let frame = 0;
      let measured = false;

      const measure = () => {
        for (const state of states) {
          if (!state.stage) continue;
          // Cache document geometry so the scroll handler only reads scrollY.
          state.top = state.stage.getBoundingClientRect().top + window.scrollY;
          // Use the CSS-sized sticky panel rather than innerHeight: svh stays
          // stable on mobile when the browser chrome collapses.
          const stickyHeight =
            state.section.querySelector<HTMLElement>('.about-expand-sticky')?.offsetHeight ??
            window.innerHeight;
          const pinDistance = Math.max(1, state.stage.offsetHeight - stickyHeight);
          // Finish shortly before the sticky stage unpins, leaving a short
          // full-bleed hold before the next section arrives.
          state.distance = Math.max(1, pinDistance * 0.86);
        }
        measured = true;
      };

      const apply = () => {
        frame = 0;
        if (!measured) measure();

        const isStatic = staticMotion.matches;
        for (const state of states) {
          const raw = Math.min(1, Math.max(0, (window.scrollY - state.top) / state.distance));
          // Smoothstep keeps the start and finish of the expansion gentle while
          // remaining directly linked to the scroll position.
          const progress = isStatic ? 1 : raw * raw * (3 - 2 * raw);
          if (progress === state.progress) continue;
          state.progress = progress;
          state.section.style.setProperty('--about-expand-progress', progress.toFixed(4));
        }
      };

      const schedule = () => {
        if (frame) return;
        frame = requestAnimationFrame(apply);
      };

      const remeasure = () => {
        measured = false;
        schedule();
      };

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', remeasure, { passive: true });
      window.addEventListener('orientationchange', remeasure, { passive: true });
      window.addEventListener('load', remeasure);
      staticMotion.addEventListener('change', remeasure);

      if ('ResizeObserver' in window) {
        new ResizeObserver(remeasure).observe(document.body);
      }
      document.fonts?.ready.then(remeasure).catch(() => {});

      remeasure();
    }

    initAboutExpansion();
  </script>

  <script>
    function initCountup() {
      const counters = document.querySelectorAll<HTMLElement>(
        '[data-countup]:not([data-countup-init])'
      );
      if (counters.length === 0) return;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.countup ?? '0', 10);
            const suffix = el.dataset.suffix ?? '';
            const duration = 1200;
            const start = performance.now();
            const tick = (now: number) => {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              el.textContent = Math.round(eased * target) + suffix;
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.4 }
      );
      counters.forEach((el) => {
        el.dataset.countupInit = 'true';
        observer.observe(el);
      });
    }

    initCountup();
  </script>
</LandingLayout>
