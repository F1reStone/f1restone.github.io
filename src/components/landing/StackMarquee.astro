---
/**
 * StackMarquee
 * FireStone Refactored: Pure SVG Logo Wall (Chameleon Mode)
 * 
 * - Removes heavy Card wrapping and static colored icons.
 * - Uses import.meta.glob to load raw SVGs, injecting currentColor and hover-glow-icon engine.
 * - Enforces smooth double-row marquee scrolling on ALL devices (mobile included).
 * 
 *  * Usage:
 *   <StackMarquee />                         // pulls from content/stack, 2 rows
 *   <StackMarquee rows={1} duration={30} />  // single strip
 *   <StackMarquee items={[{ name: 'Vercel', icon: 'brand-vercel', url: '…' }]} />
 */
import { getCollection } from 'astro:content';
import { cn } from '@/lib/cn';

// FireStone: 使用 Vite 的 import.meta.glob 批量在构建时以字符串形式引入 SVG。
// 请确保你的 SVG 文件存放在 src/assets/stack/logo/ 目录下！
const svgFiles = import.meta.glob('/src/assets/stack/logo/*.svg', { query: '?raw', import: 'default', eager: true });

export interface StackItem {
  name: string;
  /** Optional link target; when set (and `linked`), the card links here. */
  url?: string;
  logo: string;
}

interface Props {
  /** Items to show. Defaults to the src/content/stack collection (sorted by order). */
  items?: StackItem[];
  /** Number of rows. 2 = double, opposite-direction marquee (default). 1 = single strip. */
  rows?: number;
  /** Direction of the first row; each subsequent row alternates. Default "left". */
  direction?: 'left' | 'right';
  /** Seconds for one loop of the first row. Each further row is a touch faster. Default 40. */
  duration?: number;
  /** Pause a row while it is hovered so visitors can read or click. Default true. */
  pauseOnHover?: boolean;
  /** Gap between cards within a row. Default "1.5rem". */
  gap?: string;
  /** Gap between rows. Default "1rem". */
  rowGap?: string;
  /** Gradient fade on the left/right edges. Default true. */
  fade?: boolean;
  /** Wrap each card in its `url`. Default true. */
  linked?: boolean;
  /** Extra classes on the wrapper. */
  class?: string;
}

const {
  items,
  rows = 2,
  direction = 'left',
  duration = 40,
  pauseOnHover = true,
  gap = '4rem',    // FireStone: 增大 Logo 之间的水平呼吸空间
  rowGap = '3rem', // FireStone: 增大行与行之间的垂直呼吸空间
  fade = true,
  linked = true,
  class: className,
} = Astro.props;

let data: StackItem[] = items ?? [];
if (!items) {
  const entries = await getCollection('stack');
  data = entries
    .sort((a, b) => a.data.order - b.data.order)
    .map((e) => ({
      name: e.data.name,
      url: e.data.url,
      logo: e.data.logo,
    }));
}

const opposite = (d: 'left' | 'right'): 'left' | 'right' => (d === 'left' ? 'right' : 'left');
const rowCount = Math.max(1, rows);
const MIN_DURATION = 12;

const MIN_CARDS = 8;
const fill = (list: StackItem[]): StackItem[] => {
  if (list.length === 0) return list;
  const out = [...list];
  while (out.length < MIN_CARDS) out.push(...list);
  return out;
};

const rowConfigs = Array.from({ length: rowCount }, (_, r) => {
  const base = r % 2 === 0 ? data : [...data].reverse();
  return {
    items: fill(base),
    uniqueCount: base.length,
    direction: r % 2 === 0 ? direction : opposite(direction),
    duration: Math.max(MIN_DURATION, duration - r * 4),
    decorative: r > 0,
  };
});
---

<div
  class={cn('stack-marquee', className)}
  data-fade={fade ? 'true' : 'false'}
  data-pause={pauseOnHover ? 'true' : 'false'}
  style={`--row-gap: ${rowGap};`}
  aria-label="Tech stack"
>
  {
    rowConfigs.map((row) => (
      <div
        class="stack-marquee-row"
        data-direction={row.direction}
        style={`--marquee-duration: ${row.duration}s; --marquee-gap: ${gap};`}
      >
        <div class="stack-marquee-track">
          {[...row.items, ...row.items].map((item, idx) => {
            const hidden = idx >= row.uniqueCount || row.decorative;
            
            // FireStone: 解析并注入深浅模式适配的 CSS
            const rawSvg = svgFiles[`/src/assets/stack/logo/${item.logo}`] as string | undefined;
            const cleanSvg = rawSvg
              ?.replace(/\s(width|height)="[^"]*"/g, '')
              .replace(/^<svg/, '<svg class="w-auto h-8 md:h-10 object-contain" fill="currentColor"');

            return (
              <div class="stack-marquee-item">
                <a
                  href={linked ? item.url : undefined}
                  target={linked && item.url ? '_blank' : undefined}
                  rel={linked && item.url ? 'noopener noreferrer' : undefined}
                  class="flex items-center justify-center outline-none"
                  aria-hidden={hidden ? 'true' : undefined}
                  tabindex={hidden ? -1 : undefined}
                  aria-label={item.name}
                >
                  <!-- FireStone: 调用全局 hover-glow-icon 实现交互 -->
                  <span 
                    class="hover-glow-icon block"
                    style="color: var(--color-foreground);"
                    set:html={cleanSvg || `<span class="text-lg font-bold">${item.name}</span>`} 
                  />
                </a>
              </div>
            );
          })}
        </div>
      </div>
    ))
  }
</div>

<style>
  .stack-marquee {
    display: flex;
    flex-direction: column;
    gap: var(--row-gap, 1.5rem);
    width: 100%;
  }

  .stack-marquee-row {
    position: relative;
    overflow-x: visible;
    overflow-y: visible;
    width: 100%;
    
    /* FireStone: 盒模型排版
       1. 上下 padding 扩大了元素的实际绘制区域（Border-box），使得外围的 mask-image 遮罩跟着变高，给发光和放大留出完美的 24px 缓冲区，解决裁切。
       2. 对应的上下负 margin 使得它在 Flex 布局中不会推挤其他元素。
    */
    padding: 24px 0;
    margin: -24px 0;
  }

  /* 边缘羽化渐变遮罩 */
  .stack-marquee[data-fade='true'] .stack-marquee-row {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 15%, #000 85%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 15%, #000 85%, transparent 100%);
  }

  .stack-marquee-track {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap, 3rem);
    width: max-content;
    animation: stack-marquee-scroll var(--marquee-duration, 40s) linear infinite;
    will-change: transform;
  }

  .stack-marquee-row[data-direction='right'] .stack-marquee-track {
    animation-direction: reverse;
  }

  @media (hover: hover) {
    .stack-marquee[data-pause='true'] .stack-marquee-row:hover .stack-marquee-track {
      animation-play-state: paused;
    }
  }

  .stack-marquee-item {
    flex: none;
    /* 去除原来的固定 width，交由内部的 SVG 原生比例排版，获得极其舒适的呼吸感 */
  }

  @keyframes stack-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap, 3rem) / 2)), 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-marquee-track {
      animation: none;
      transform: none;
    }
    .stack-marquee-row {
      overflow-x: auto;
    }
  }
</style>
